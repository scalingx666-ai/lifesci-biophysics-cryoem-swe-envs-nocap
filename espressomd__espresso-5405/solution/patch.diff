+   "cell_type": "code",
+   "id": "9e606412",
+   "metadata": {},
+   "source": [
+    "BOX_L = [80, 80, 1]\n",
+    "AGRID = 1.0\n",
+    "DIFFUSION_COEFFICIENT = 0.06\n",
+    "TAU = 1.0\n",
+    "EXT_FORCE_DENSITY = [0, 0, 0]\n",
+    "FLUID_DENSITY = 1.0\n",
+    "FLUID_VISCOSITY = 1.0\n",
+    "FLUID_VELOCITY = [0.04, 0.04, 0.0]\n",
