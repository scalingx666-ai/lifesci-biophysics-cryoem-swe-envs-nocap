-   "id": "606c2a43",
-   "metadata": {},
-   "outputs": [],
-   "source": [
-    "AGRID = 1.0\n",
-    "TAU = 1.0\n",
-    "KT = 2.0\n",
-    "PERMITTIVITY = 0.28\n",
-    "DIFFUSION_COEFFICIENT = 0.25\n",
