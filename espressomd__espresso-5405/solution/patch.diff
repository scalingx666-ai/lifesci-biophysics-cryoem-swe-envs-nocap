-   "cell_type": "code",
-   "execution_count": null,
-   "id": "c9b7f9c6",
-   "metadata": {},
-   "outputs": [],
-   "source": [
-    "wall_left = espressomd.shapes.Wall(normal=[1, 0, 0], dist=padding)\n",
