+def hash_file(path: Path, chunk_size: int = 2048) -> str:
+    assert path.is_file(), f"{path!s} doesn't exist"
+    m = hashlib.sha256()
+    with open(path, "rb") as ifs:
+        chunk = ifs.read(chunk_size)
+        while len(chunk) > 0:
+            m.update(chunk)
+            chunk = ifs.read(chunk_size)
+    return m.hexdigest()
+
