-    command = " ".join(parts + [run_command.decode()])
-  else:
-    command = submit_command
-  submit_command = str(submit_command) # unicode workaround
-
-  if dry_run:
-    print("Dry run: job not submitted. Trial directory created here:", os.path.dirname(submit_path))
