+def test_a_sheet():
+    """A triangular sheet with springs between nearest neighbors."""
+    a, height = 2.5, 10.0
+    plane = np.array([[a, 0, 0], [-a / 2, a * np.sqrt(3) / 2, 0], [0, 0, height]])
+    sheet = mdapy.System(
+        np.array([[0, 0, height / 2]]),
+        mdapy.Box(plane, pbc=(True, True, False)),
