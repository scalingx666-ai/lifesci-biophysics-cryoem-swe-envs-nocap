+@pytest.mark.parametrize("given, applied", [
+    (DEPTH, DEPTH),
+    ({"profile": "quick", "targets": "band position", "time_budget_s": "90"},
+     {"profile": "quick", "targets": ["band position"], "time_budget_s": 90.0}),
