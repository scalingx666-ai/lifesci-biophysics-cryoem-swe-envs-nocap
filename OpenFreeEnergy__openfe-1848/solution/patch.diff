+        hashed_key = _hash_quickrun_inputs(outfile, trans)
+        pathlib.Path("quickrun_cache").mkdir()
+        dag_cache = pathlib.Path("quickrun_cache", f"dag-cache-{hashed_key}.json")
+        dag_cache.touch()
