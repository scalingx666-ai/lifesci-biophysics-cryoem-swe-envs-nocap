+
+STRTOBOOL = {
+    'y': True,
+    'yes': True,
+    't': True,
+    'true': True,
+    'on': True,
+    '1': True,
+    'n': False,
+    'no': False,
+    'f': False,
+    'false': False,
+    'off': False,
+    '0': False
+}
+
+
+def strtobool(value: str) -> bool:
+    """Interpret string as a boolean."""
+    result = STRTOBOOL.get(value.lower())
+    if result is None:
+        raise ValueError(f"'{value}' cannot be converted to boolean")
+    return result
