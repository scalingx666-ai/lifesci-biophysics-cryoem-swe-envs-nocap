+    found = result.thermal_displacements(temperatures, mesh=6)
+    # phonopy's physical constants are older, by a few parts in 10^7
+    np.testing.assert_allclose(
+        found, expected, rtol=0, atol=1e-5 * np.abs(expected).max()
+    )
