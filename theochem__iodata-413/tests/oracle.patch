+    mol = IOData(atnums=np.array([6, 6]), atcoords=atcoords)
+    with pytest.raises(PrepareDumpError, match="coordinates"):
+        dump_one(mol, os.path.join(tmpdir, "far.sdf"))
+
+
+def test_dump_coordinate_largest(tmpdir):
