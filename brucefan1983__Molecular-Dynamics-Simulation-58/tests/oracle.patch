+    "        G = vel_eta[m - 1] * vel_eta[m - 1] / mas_eta[m - 1] - kT\n",
+    "        if m == 0:\n",
+    "            G = Ek2 * factor * factor - dN * kT\n",
+    "        vel_eta[m] = tmp * (tmp * vel_eta[m] + dt4 * G)\n",
+    "\n",
+    "    # Update velocity of the last (M - 1) thermostat:\n",
+    "    G = vel_eta[M - 2] * vel_eta[M - 2] / mas_eta[M - 2] - kT\n",
+    "    vel_eta[M - 1] += dt4 * G\n",
+    "\n",
