+        auto edge_vec = saved[1];
+        auto edge_weight = saved[2];
+        auto num_atoms = ctx->saved_data["num_atoms"].toInt();
+        auto grad_edge_vec = grad_outputs[1];
+        auto grad_edge_weight = grad_outputs[2];
+        auto r0 = edge_weight.nonzero().squeeze(-1);
