+import os
+import sys
+
+Import('env')
+Import('loos')
+
+clone = env.Clone()
+clone.Prepend(LIBS = [loos])
+
+files = 'suitename_definitions.dat'
+PREFIX = env['PREFIX']
+
+if env.USING_CONDA:
+    share_path = os.path.join(PREFIX, "share", "loos")
