-my @pbc_atoms;
-my (@a_1A, @a_2A, @a_3A, @a_1B, @a_3B, @a_1C, @a_2C, @a_3C);
-
-foreach (@reference_atoms){
-	my ($resid, $oldx, $oldy, $oldz) = split(' ', $_);
-
-	my $x_A = sprintf("%.3f", ($oldx-$transfer_x));
-	my $x_B = $oldx;
-	my $x_C = sprintf("%.3f", ($oldx+$transfer_x));
-
-	my $y_1 = sprintf("%.3f", ($oldy+$transfer_y));
