+    if os.path.exists(metr_file_path):
+        # we make a backup of the metrics file (rename)
+        bckp_date = f'{time.strftime("%Y%m%d")}-{time.strftime("%H%M%S")}'
+        os.rename(metr_file_path, metr_file_path.replace(".csv", f"_{bckp_date}.csv"))
