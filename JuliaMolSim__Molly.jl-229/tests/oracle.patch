+        define_bias = SquareBias(400u"kJ * mol^-1 * nm^-2",1.5u"nm") # apply square bias potential with k=400 and target distance 1.5 nm
+        general_inters = (BiasPotential(define_cv, define_bias),) # add to general interactions
