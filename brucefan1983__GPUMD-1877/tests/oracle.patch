+static __device__ __forceinline__ void find_c6_stable(
+  const float* g_c6_ref,
+  const int z1,
+  const int z2,
+  const int z12,
+  const float cn1,
+  const float cn2,
+  float& c6,
+  float& dc6)
+{
+  const int n1 = num_cn[z1];
+  const int n2 = num_cn[z2];
+  float d1[max_cn];
+  float w1[max_cn];
+  float w2[max_cn];
+  float m1 = 1.0e30f;
+  float m2 = 1.0e30f;
+  for (int i = 0; i < n1; ++i) {
+    d1[i] = cn1 - cn_ref[z1 * max_cn + i];
+    m1 = fminf(m1, d1[i] * d1[i]);
+  }
+  for (int j = 0; j < n2; ++j) {
+    const float d = cn2 - cn_ref[z2 * max_cn + j];
+    w2[j] = d * d;
+    m2 = fminf(m2, w2[j]);
+  }
+  float s1 = 0.0f;
+  float s2 = 0.0f;
+  for (int i = 0; i < n1; ++i) {
+    w1[i] = exp(-4.0f * (d1[i] * d1[i] - m1));
+    s1 += w1[i];
+  }
+  for (int j = 0; j < n2; ++j) {
+    w2[j] = exp(-4.0f * (w2[j] - m2));
+    s2 += w2[j];
+  }
+  float d1_mean = 0.0f;
+  for (int i = 0; i < n1; ++i) {
+    w1[i] /= s1;
+    d1_mean += w1[i] * d1[i];
+  }
+  for (int j = 0; j < n2; ++j) {
+    w2[j] /= s2;
+  }
+  c6 = 0.0f;
+  dc6 = 0.0f;
+  for (int i = 0; i < n1; ++i) {
+    float c6_i = 0.0f;
+    for (int j = 0; j < n2; ++j) {
+      c6_i += w2[j] * ((z1 < z2) ? g_c6_ref[z12 * max_cn2 + i * max_cn + j]
+                                 : g_c6_ref[z12 * max_cn2 + j * max_cn + i]);
+    }
+    c6 += w1[i] * c6_i;
+    dc6 += w1[i] * (-8.0f) * (d1[i] - d1_mean) * c6_i;
+  }
+}
