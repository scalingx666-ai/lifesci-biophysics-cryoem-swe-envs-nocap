+            set_num_threads(threads)
+            path = tmp_path / f"{threads}.gz"
+            with open_output(path) as file:
+                file.write(text)
+            written.append(path.read_bytes())
+    finally:
+        set_num_threads(before)
+    assert written[0] == written[1] == written[2]
