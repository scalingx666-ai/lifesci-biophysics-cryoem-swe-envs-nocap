         new_node_order.append(
             [mapping_dict[int(n[0])], mapping_dict[int(n[1])], int(n[2])]
         )
-    new_node_order = jnp.asarray(new_node_order)
+    # We need `.reshape(-1, 3)` because `new_node_order` is empty for point-neurons.
