+        # wrap the shuffled group:
+        wrapped_pos = group.wrap(
+            compound=compound, center=center, inplace=False
+        )
+        # check for correct result:
+        assert_almost_equal(
+            wrapped_pos, ref_wrapped_pos, decimal=self.precision
