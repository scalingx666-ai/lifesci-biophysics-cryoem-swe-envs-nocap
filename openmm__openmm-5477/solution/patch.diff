diff --git a/wrappers/python/openmm/unit/unit_operators.py b/wrappers/python/openmm/unit/unit_operators.py
index 7715f35c13..a2ec8148b9 100644
--- a/wrappers/python/openmm/unit/unit_operators.py
+++ b/wrappers/python/openmm/unit/unit_operators.py
@@ -125,10 +125,10 @@ def _unit_class_mul(self, other):
         unit = self * other.unit
         return Quantity(value, unit).reduce_unit(self)
     else:
-        # print "scalar * unit"
-        # Is reduce_unit needed here?  I hope not, there is a performance issue...
-        # return Quantity(other, self).reduce_unit(self)
-        return Quantity(other, self)
+        result = Quantity(other, self)
+        if self.is_dimensionless():
+            result = result.reduce_unit(self)
+        return result
 
 Unit.__mul__ = _unit_class_mul
 Unit.__rmul__ = Unit.__mul__
