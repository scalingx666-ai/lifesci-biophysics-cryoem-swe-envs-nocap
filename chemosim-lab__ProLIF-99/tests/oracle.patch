+        with catch_rdkit_logs(), catch_warning(
+            message=r"^(Could not sanitize molecule)|"
+            r"(No `bonds` attribute in this AtomGroup)"
+        ):
+            pdbqt_mol = pdbqt.atoms.convert_to.rdkit(
