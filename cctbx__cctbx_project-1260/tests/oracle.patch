diff --git a/simtbx/kokkos/SConscript b/simtbx/kokkos/SConscript
index bc72ee122d2..92f6951d578 100644
--- a/simtbx/kokkos/SConscript
+++ b/simtbx/kokkos/SConscript
@@ -107,6 +107,9 @@ kokkos_env.Replace(SHCCFLAGS=ccflags)
 kokkos_env.Replace(CXX=os.environ['CXX'])
 kokkos_env.Replace(SHCXX=os.environ['CXX'])
 kokkos_env.Replace(SHLINK=os.environ['CXX'])
+if use_cuda:
+  # libkokkoscore.so uses the shared CUDA runtime; nvcc_wrapper defaults to static
