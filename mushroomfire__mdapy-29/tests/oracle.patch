diff --git a/tests/fuzz/fuzz_numbers.cpp b/tests/fuzz/fuzz_numbers.cpp
new file mode 100644
index 00000000..bc7b5bd2
--- /dev/null
+++ b/tests/fuzz/fuzz_numbers.cpp
@@ -0,0 +1,151 @@
+// Copyright (c) 2022-2026, Yongchao Wu
+// This Source Code Form is subject to the terms of the Mozilla Public License,
+// v. 2.0. If a copy of the MPL was not distributed with this file, You can
+// obtain one at https://mozilla.org/MPL/2.0/.
+//
+// A libFuzzer target of the number kernels of text files, with clang:
+//
+//   clang++ -std=c++17 -O1 -g -fsanitize=fuzzer,address,undefined -ffp-contract=off
+//       -Isrc/cpp -o fuzz_numbers tests/fuzz/fuzz_numbers.cpp
+//       src/cpp/core/parallel.cpp src/cpp/io/text.cpp
+//   ./fuzz_numbers -max_total_time=600 corpus/
+//
+// Any input must be read without a fault. A plain decimal number must give the
+// double that strtod gives in the C locale, bit for bit. And any double, given
+// as the first eight bytes, must come back unchanged when written and read
+// again, with and without a decimal shift, in no more digits than the shortest
+// text that std::to_chars writes.
+
+#include <charconv>
+#include <clocale>
+#include <cmath>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <string>
+#include <vector>
+
+#if defined(__APPLE__)
+#include <xlocale.h>
+#else
+#include <locale.h>
+#endif
+
+#include "io/text.h"
+
+namespace {
+
+using mdapy::io::Column;
+using mdapy::io::Kind;
+
+[[noreturn]] void fail(const char* what, const std::string& text) {
+    std::fprintf(stderr, "%s: [%s]\n", what, text.c_str());
+    std::abort();
+}
+
+// Digits with an optional sign, decimal point and exponent: the numbers that
+// both Python's float() and strtod read, and read alike.
+bool plain_decimal(const char* p, std::size_t n) {
+    std::size_t i = 0;
+    if (i < n && (p[i] == '+' || p[i] == '-')) ++i;
+    std::size_t digits = 0;
+    while (i < n && p[i] >= '0' && p[i] <= '9') ++i, ++digits;
+    if (i < n && p[i] == '.') {
+        ++i;
+        while (i < n && p[i] >= '0' && p[i] <= '9') ++i, ++digits;
+    }
+    if (digits == 0) return false;
+    if (i < n && (p[i] == 'e' || p[i] == 'E')) {
+        ++i;
+        if (i < n && (p[i] == '+' || p[i] == '-')) ++i;
+        std::size_t exponent = 0;
+        while (i < n && p[i] >= '0' && p[i] <= '9') ++i, ++exponent;
+        if (exponent == 0) return false;
+    }
+    return i == n;
+}
+
+double c_strtod(const std::string& text, bool& whole) {
+    static locale_t c = newlocale(LC_ALL_MASK, "C", nullptr);
+    char* end = nullptr;
+    double value = strtod_l(text.c_str(), &end, c);
+    whole = end == text.c_str() + text.size();
+    return value;
+}
+
+bool same(double a, double b) {
+    if (std::isnan(a) && std::isnan(b)) return true;
+    return std::memcmp(&a, &b, sizeof a) == 0;
+}
+
+// The significant digits of a decimal number written by either writer.
+int significant_digits(const std::string& text) {
+    std::string digits;
+    for (char ch : text) {
+        if (ch == 'e' || ch == 'E') break;
+        if (ch >= '0' && ch <= '9') digits += ch;
+    }
+    std::size_t first = digits.find_first_not_of('0');
+    if (first == std::string::npos) return 1;
+    std::size_t last = digits.find_last_not_of('0');
+    return static_cast<int>(last - first + 1);
+}
+
+std::string written(double value, int shift) {
+    Column column;
+    column.kind = Kind::Float;
+    column.data = &value;
+    column.shift = shift;
+    std::vector<Column> columns{column};
+    std::string text = mdapy::io::format_table(1, columns);
+    if (text.empty() || text.back() != '\n') fail("no line", text);
+    text.pop_back();
+    return text;
+}
+
+void round_trip(double value, int shift) {
+    const std::string text = written(value, shift);
+    double back = 0;
+    if (!mdapy::io::parse_double(text.data(), text.data() + text.size(), back, -shift)) {
+        fail("written text not read", text);
+    }
+    if (!same(value, back)) fail("value changed in a round trip", text);
+    if (shift == 0 && std::isfinite(value)) {
+        char shortest[64];
+        auto result = std::to_chars(shortest, shortest + sizeof shortest, value);
+        const std::string reference(shortest, result.ptr);
+        if (significant_digits(text) > significant_digits(reference)) {
+            fail("more digits than the shortest", text + "] against [" + reference);
+        }
+    }
+}
+
+}  // namespace
+
+extern "C" int LLVMFuzzerTestOneInput(const std::uint8_t* data, std::size_t size) {
+    const char* text = reinterpret_cast<const char*>(data);
+    double value = 0;
+    std::int64_t integer = 0;
+    const bool read = mdapy::io::parse_double(text, text + size, value);
+    mdapy::io::parse_int64(text, text + size, integer);
+    if (size > 0) {
+        double shifted = 0;
+        mdapy::io::parse_double(text + 1, text + size, shifted,
+                                static_cast<int>(static_cast<std::int8_t>(data[0])) % 40);
+    }
+    if (plain_decimal(text, size)) {
+        const std::string number(text, size);
+        bool whole = false;
+        const double reference = c_strtod(number, whole);
+        if (read != whole) fail("accepted differently from strtod", number);
+        if (read && !same(value, reference)) fail("differs from strtod", number);
+    }
+    if (size >= 8) {
+        double bits;
+        std::memcpy(&bits, data, sizeof bits);
+        round_trip(bits, 0);
+        if (size >= 9) round_trip(bits, static_cast<int>(static_cast<std::int8_t>(data[8])) % 8);
+    }
+    return 0;
+}
diff --git a/tests/fuzz/fuzz_table.cpp b/tests/fuzz/fuzz_table.cpp
new file mode 100644
index 00000000..61578df1
--- /dev/null
+++ b/tests/fuzz/fuzz_table.cpp
@@ -0,0 +1,170 @@
+// Copyright (c) 2022-2026, Yongchao Wu
+// This Source Code Form is subject to the terms of the Mozilla Public License,
+// v. 2.0. If a copy of the MPL was not distributed with this file, You can
+// obtain one at https://mozilla.org/MPL/2.0/.
+//
+// A libFuzzer target of the text tables, built as fuzz_numbers.cpp is:
+//
+//   clang++ -std=c++17 -O1 -g -fsanitize=fuzzer,address,undefined -ffp-contract=off
+//       -Isrc/cpp -o fuzz_table tests/fuzz/fuzz_table.cpp
+//       src/cpp/core/parallel.cpp src/cpp/io/text.cpp
+//
+// The first bytes choose the columns (kind and width), the rows and the comment
+// character; the rest is the text. Any text must be read or refused with a
+// ParseError, without a fault. A table that was read must be written and read
+// again to the same values.
+
+#include <cmath>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <string>
+#include <vector>
+
+#include "core/parallel.h"
+#include "io/text.h"
+
+namespace {
+
+using mdapy::io::Column;
+using mdapy::io::Kind;
+
+constexpr Kind kKinds[] = {Kind::Float, Kind::Int, Kind::Bool, Kind::String, Kind::Skip};
+
+struct Table {
+    std::vector<Column> columns;
+    std::vector<std::vector<double>> floats;
+    std::vector<std::vector<std::int64_t>> ints;
+    std::vector<std::vector<std::uint8_t>> bools;
+    std::vector<std::vector<std::uint32_t>> codes;
+};
+
+Table make(const std::vector<std::pair<Kind, int>>& layout, std::int64_t rows) {
+    Table table;
+    table.floats.reserve(layout.size());
+    table.ints.reserve(layout.size());
+    table.bools.reserve(layout.size());
+    table.codes.reserve(layout.size());
+    for (const auto& [kind, width] : layout) {
+        Column column;
+        column.kind = kind;
+        column.width = width;
+        const std::size_t n = static_cast<std::size_t>(rows * width);
+        switch (kind) {
+            case Kind::Float:
+                column.data = table.floats.emplace_back(n).data();
+                break;
+            case Kind::Int:
+                column.data = table.ints.emplace_back(n).data();
+                break;
+            case Kind::Bool:
+                column.data = table.bools.emplace_back(n).data();
+                break;
+            case Kind::String:
+                column.data = table.codes.emplace_back(n).data();
+                break;
+            case Kind::Skip:
+                break;
+        }
+        table.columns.push_back(column);
+    }
+    return table;
+}
+
+bool same(double a, double b) {
+    return (std::isnan(a) && std::isnan(b)) || std::memcmp(&a, &b, sizeof a) == 0;
+}
+
+}  // namespace
+
+extern "C" int LLVMFuzzerInitialize(int*, char***) {
+    mdapy::set_num_threads(2);
+    return 0;
+}
+
+extern "C" int LLVMFuzzerTestOneInput(const std::uint8_t* data, std::size_t size) {
+    if (size < 3) return 0;
+    const int count = 1 + data[0] % 4;
+    if (size < static_cast<std::size_t>(count) + 2) return 0;
+    std::vector<std::pair<Kind, int>> layout;
+    for (int c = 0; c < count; ++c) {
+        layout.emplace_back(kKinds[data[1 + c] % 5], 1 + (data[1 + c] / 5) % 3);
+    }
+    const std::int64_t rows = data[1 + count] % 16;
+    const char comment = (data[0] & 0x80) != 0 ? '#' : '\0';
+    const std::size_t head = static_cast<std::size_t>(count) + 2;
+    const char* text = reinterpret_cast<const char*>(data) + head;
+    const auto length = static_cast<std::int64_t>(size - head);
+
+    try {
+        mdapy::io::skip_lines(text, length, 0, rows);
+    } catch (const mdapy::io::ParseError&) {
+    }
+    Table table = make(layout, rows);
+    try {
+        mdapy::io::parse_table(text, length, 0, rows, table.columns, comment);
+    } catch (const mdapy::io::ParseError&) {
+        return 0;
+    }
+
+    // Written and read again: the same values and the same categories.
+    std::vector<std::pair<Kind, int>> kept;
+    for (const auto& item : layout) {
+        if (item.first != Kind::Skip) kept.push_back(item);
+    }
+    if (kept.empty()) return 0;
+    Table first = make(kept, rows);
+    std::size_t f = 0, i = 0, b = 0, s = 0;
+    for (std::size_t c = 0, k = 0; c < layout.size(); ++c) {
+        const Column& column = table.columns[c];
+        if (column.kind == Kind::Skip) continue;
+        Column& copy = first.columns[k++];
+        switch (column.kind) {
+            case Kind::Float:
+                first.floats[f] = table.floats[f];
+                copy.data = first.floats[f++].data();
+                break;
+            case Kind::Int:
+                first.ints[i] = table.ints[i];
+                copy.data = first.ints[i++].data();
+                break;
+            case Kind::Bool:
+                first.bools[b] = table.bools[b];
+                copy.data = first.bools[b++].data();
+                break;
+            case Kind::String:
+                first.codes[s] = table.codes[s];
+                copy.data = first.codes[s++].data();
+                copy.categories = column.categories;
+                break;
+            case Kind::Skip:
+                break;
+        }
+    }
+    const std::string written = mdapy::io::format_table(rows, first.columns);
+    Table again = make(kept, rows);
+    try {
+        mdapy::io::parse_table(written.data(), static_cast<std::int64_t>(written.size()), 0, rows,
+                               again.columns, '\0');
+    } catch (const mdapy::io::ParseError& error) {
+        std::fprintf(stderr, "written table not read: %s\n[%s]\n", error.what(), written.c_str());
+        std::abort();
+    }
+    for (std::size_t k = 0; k < first.floats.size(); ++k) {
+        for (std::size_t n = 0; n < first.floats[k].size(); ++n) {
+            if (!same(first.floats[k][n], again.floats[k][n])) std::abort();
+        }
+    }
+    if (first.ints != again.ints || first.bools != again.bools) std::abort();
+    for (std::size_t c = 0, k = 0; c < kept.size(); ++c) {
+        if (kept[c].first != Kind::String) continue;
+        const Column& a = first.columns[c];
+        const Column& z = again.columns[c];
+        for (std::size_t n = 0; n < first.codes[k].size(); ++n) {
+            if (a.categories[first.codes[k][n]] != z.categories[again.codes[k][n]]) std::abort();
+        }
+        ++k;
+    }
+    return 0;
+}
diff --git a/tests/io/test_damaged_files.py b/tests/io/test_damaged_files.py
new file mode 100644
index 00000000..7f91c8b5
--- /dev/null
+++ b/tests/io/test_damaged_files.py
@@ -0,0 +1,142 @@
+# Copyright (c) 2022-2026, Yongchao Wu
+# This Source Code Form is subject to the terms of the Mozilla Public License,
+# v. 2.0. If a copy of the MPL was not distributed with this file, You can
+# obtain one at https://mozilla.org/MPL/2.0/.
+
+"""Damaged files of every format give an error of MDAPY, never another one.
+
+Each sample file is damaged at random, from a fixed seed, as files are: cut short,
+lines lost or doubled, bytes changed, numbers replaced by others. Reading the result
+must give a system or an MdapyError (FileFormatError for most), for one frame and for
+a whole trajectory.
+"""
+
+import random
+
+import numpy as np
+import pytest
+
+import mdapy
+from mdapy.build import build_crystal
+from mdapy.errors import MdapyError
+
+TOKENS = [
+    b"nan", b"inf", b"-1", b"0", b"1e308", b"99999999999999999999", b"x", b"", b"T",
+    b"1.5", b"-0", b"2147483648", b"-9223372036854775809",
+]  # fmt: skip
+INSERTS = [b"\n", b"\r\n", b"\t", b"  ", b"#", b'"', b"=", b"\x00"]
+
+
+def damaged(data: bytes, r: random.Random) -> bytes:
+    """data with one to eight random kinds of damage."""
+    b = bytearray(data)
+    for _ in range(r.choice([1, 1, 1, 2, 3, 8])):
+        if not b:
+            break
+        i = r.randrange(len(b))
+        lines = bytes(b).split(b"\n")
+        kind = r.randrange(9)
+        if kind == 0:
+            b[i] = r.randrange(256)
+        elif kind == 1:
+            del b[i:]
+        elif kind == 2:
+            b[i:i] = bytes(r.randrange(256) for _ in range(r.randrange(1, 8)))
+        elif kind == 3 and len(lines) > 1:
+            del lines[r.randrange(len(lines))]
+            b = bytearray(b"\n".join(lines))
+        elif kind == 4 and len(lines) > 1:
+            k = r.randrange(len(lines))
+            lines.insert(k, lines[k])
+            b = bytearray(b"\n".join(lines))
+        elif kind == 5:
+            tokens = bytes(b).split(b" ")
+            tokens[r.randrange(len(tokens))] = r.choice(TOKENS)
+            b = bytearray(b" ".join(tokens))
+        elif kind == 6:
+            del b[i : i + r.randrange(1, 40)]
+        elif kind == 7:
+            j = r.randrange(len(b))
+            b[i], b[j] = b[j], b[i]
+        else:
+            b[i:i] = r.choice(INSERTS)
+    return bytes(b)
+
+
+def samples(tmp_path) -> dict[str, tuple[str, str, bytes]]:
+    rng = np.random.default_rng(1)
+    system = build_crystal("fcc", 3.6, elements="Cu", repeat=(2, 2, 2))
+    system = system.with_columns(
+        velocities=rng.normal(size=(len(system), 3)),
+        forces=rng.normal(size=(len(system), 3)),
+        charge=rng.normal(size=len(system)),
+    ).with_info(energy=-12.5)
+    files = {}
+    for fmt, name, frames in [
+        ("extxyz", "a.xyz", [system, system]),
+        ("lammps-data", "a.data", system),
+        ("lammps-dump", "a.dump", [system, system]),
+        ("poscar", "POSCAR", system),
+        ("mdapy", "a.mdapy", [system, system]),
+    ]:
+        mdapy.io.write(tmp_path / name, frames, fmt)
+        files[fmt] = (fmt, name, (tmp_path / name).read_bytes())
+    files["plain xyz"] = (
+        "extxyz",
+        "b.xyz",
+        b"3\nMMM12 made of C atoms; MMM12 logo\nC 0 0 0\nH 1.0 0 0\nH 0 1.0 0\n",
+    )
+    files["cif"] = (
+        "cif",
+        "a.cif",
+        b"data_x\n_cell_length_a 3.6\n_cell_length_b 3.6\n_cell_length_c 3.6\n"
+        b"_cell_angle_alpha 90\n_cell_angle_beta 90\n_cell_angle_gamma 90\n"
+        b"_symmetry_space_group_name_H-M 'F m -3 m'\nloop_\n_atom_site_label\n"
+        b"_atom_site_type_symbol\n_atom_site_fract_x\n_atom_site_fract_y\n"
+        b"_atom_site_fract_z\nCu1 Cu 0 0 0\n",
+    )
+    files["pdb"] = (
+        "pdb",
+        "a.pdb",
+        b"CRYST1    3.600    3.600    3.600  90.00  90.00  90.00 P 1           1\n"
+        b"ATOM      1  CU  CU  A   1       0.000   0.000   0.000  1.00  0.00          CU\n"
+        b"ATOM      2  CU  CU  A   1       1.800   1.800   0.000  1.00  0.00          CU\n"
+        b"END\n",
+    )
+    return files
+
+
+@pytest.mark.parametrize(
+    "sample",
+    [
+        "extxyz",
+        "plain xyz",
+        "lammps-data",
+        "lammps-dump",
+        "poscar",
+        "mdapy",
+        "cif",
+        "pdb",
+    ],
+)
+def test_damaged_files_give_errors_of_mdapy(tmp_path, sample):
+    fmt, name, data = samples(tmp_path)[sample]
+    r = random.Random(f"{sample} 20261106")
+    path = tmp_path / ("damaged-" + name)
+    for _ in range(120):
+        text = damaged(data, r)
+        path.write_bytes(text)
+        try:
+            mdapy.io.read(path, fmt)
+        except MdapyError:
+            pass
+        except Exception as e:
+            pytest.fail(f"{type(e).__name__}: {e} reading {text[:200]!r}")
+        try:
+            with mdapy.io.read_trajectory(path, fmt) as trajectory:
+                for _frame in trajectory:
+                    pass
+        except MdapyError:
+            pass
+        except Exception as e:
+            pytest.fail(f"{type(e).__name__}: {e} reading frames of {text[:200]!r}")
