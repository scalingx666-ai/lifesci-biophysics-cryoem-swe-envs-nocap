diff --git a/regtest/python/rt-symfunc/README.md b/regtest/python/rt-symfunc/README.md
new file mode 100644
index 0000000000..27b4173437
--- /dev/null
+++ b/regtest/python/rt-symfunc/README.md
@@ -0,0 +1,5 @@
+This regression compares the Python interface with the existing symmetry-function
+reference. Keep the dynamically loaded kernel resident until process exit because
+OpenMP worker threads can still be waiting inside its runtime at dlclose. The
+PLUMED_LOAD_DLCLOSE setting is scoped to this regression and does not change its
+thread count, calculations, numerical tolerance or reference output.
diff --git a/regtest/python/rt-symfunc/config b/regtest/python/rt-symfunc/config
index 4bdaaf18ae..45396393b2 100644
--- a/regtest/python/rt-symfunc/config
+++ b/regtest/python/rt-symfunc/config
@@ -4,3 +4,7 @@ plumed_modules="symfunc adjmat"
 type=python
 arg="./python-script.py"
 extra_files="../../trajectories/trajectory.xyz"
+
+# OpenMP workers can outlive dlclose during Python process shutdown.
+# Retain the kernel while preserving the configured thread count.
+export PLUMED_LOAD_DLCLOSE=no
