diff --git a/.gitlab-ci.yml b/.gitlab-ci.yml
index 230fbeb91f..074c65a7fc 100644
--- a/.gitlab-ci.yml
+++ b/.gitlab-ci.yml
@@ -63,6 +63,27 @@ nocuda-tests:
     when: on_success
     expire_in: 1 week
 
+packaging:
+  stage: lint
+  image: $DOCKER_TAG
+  needs: ["docker_build"]
+  tags:
+    - aws-tardis-cpu
+  rules:
+    - if: $CI_EXTERNAL_PULL_REQUEST_IID
+    - if: '$CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH'
+  # Specify cuda arch, so that a GPU is not required to detect the cuda arch.
+  variables:
+    CMAKE_ARGS: -DCUDA_ARCH=75
+  script:
+    - python setup.py sdist
+    - pip install dist/timemachine-*.tar.gz
+  artifacts:
+    name: "$CI_JOB_NAME-$CI_COMMIT_REF_NAME-packaging"
+    paths:
+        - dist/
+    expire_in: 1 week
+
 nogpu-tests:
   stage: test
   image: $DOCKER_TAG
