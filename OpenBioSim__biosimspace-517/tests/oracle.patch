+                                _mol_info.atom_idx(_p.atom1()),
+                                _mol_info.atom_idx(_p.atom2()),
+                                _mol_info.atom_idx(_p.atom3()),
+                                _p.function(),
+                            )
+                    edit_mol.set_property("improper" + _suffix, _new_impropers)
+
