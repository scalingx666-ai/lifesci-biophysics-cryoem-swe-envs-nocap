+   "source": [
+    "from cryosparc.util import first\n",
+    "\n",
+    "data = curate_exposures_job.interact(\"get_fields_and_thresholds\")\n",
+    "\n",
+    "idx_field = first(field for field in data[\"fields\"] if field[\"name\"] == \"idx\")\n",
+    "assert idx_field\n",
+    "idx_field[\"thresholds\"] = [5, 14]\n",
