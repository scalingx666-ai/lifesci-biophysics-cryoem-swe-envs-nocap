diff --git a/.github/workflows/actions.yml b/.github/workflows/actions.yml
new file mode 100644
index 0000000..d030ab7
--- /dev/null
+++ b/.github/workflows/actions.yml
@@ -0,0 +1,49 @@
+name: actions
+
+on:
+  push:
+    branches:
+      - master
+  pull_request:
+    branches:
+      - master
+  schedule:
+    - cron: '0 6 * * *'
+
+jobs:
+  test:
+    runs-on: ${{ matrix.os }}
+    strategy:
+      fail-fast: false
+      matrix:
+      # windows-latest is disabled due to cmake failure:
+      # https://github.com/awvwgk/setup-fortran/issues/6
+        os: [ubuntu-latest, macos-latest]
+        compiler: ['make', 'cmake']
+
+    steps:
+    - uses: actions/checkout@v3
+    - uses: awvwgk/setup-fortran@main
+      id: setup-fortran
+      with:
+        compiler: gcc
+        version: 11
+
+    - name: Compile using make
+      if: matrix.compiler == 'make'
+      run: |
+        make
+      shell: bash
+
+    - name: Compile using cmake
+      if: matrix.compiler == 'cmake'
+      run: |
+        cmake ./ && cmake --build ./
+      shell: bash
+
+    - name: Run
+      run: |
+          cd example
+          ../packmol < water_box.inp
+          cd ..
+      shell: bash
