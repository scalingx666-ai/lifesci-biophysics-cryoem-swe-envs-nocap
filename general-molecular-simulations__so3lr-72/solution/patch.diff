+def _charged_box(n=60, box=14.0, seed=1):
+    rng = np.random.default_rng(seed)
+    positions = rng.uniform(0, box, (n, 3))
+    charges = rng.uniform(-0.6, 0.6, n)
+    return positions, charges - charges.mean(), box
