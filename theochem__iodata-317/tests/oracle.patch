-package:
-  version: "{{ PROJECT_VERSION }}"
-  name: 'qc-iodata'
-
-source:
-  path: ../../
-
-build:
-  number: 0
-  noarch: python
-  script: "{{ PYTHON }} -m pip install . --no-deps"
