-    - iodata-convert = iodata.__main__:main
-
-requirements:
-  host:
-    - python
-    - numpy >=1.0
-    - setuptools
-  run:
-    - python
-    - scipy
-    - attrs >=20.1.0
-    - importlib_resources  # [py<37]
-
