+    def __setitem__(self, key: int | slice, item: bytes): ...
+
+class DsetType(int, Enum):
+    T_F32 = ...
+    T_F64 = ...
+    T_C32 = ...
+    T_C64 = ...
+    T_I8 = ...
+    T_I16 = ...
+    T_I32 = ...
+    T_I64 = ...
+    T_U8 = ...
+    T_U16 = ...
+    T_U32 = ...
+    T_U64 = ...
+    T_STR = ...
+    T_OBJ = ...
+
+class Data:
+    def __init__(self, other: "Data" | None = None) -> None: ...
+    def innerjoin(self, key: str, other: "Data") -> "Data": ...
+    def totalsz(self) -> int: ...
+    def ncol(self) -> int: ...
+    def nrow(self) -> int: ...
+    def key(self, index: int) -> str: ...
