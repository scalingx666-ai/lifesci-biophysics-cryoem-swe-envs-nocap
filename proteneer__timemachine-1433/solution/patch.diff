+        if bond.GetBeginAtom().GetSymbol() == "H":
+            h_atom_idx = bond.GetBeginAtomIdx()
+            break
+        elif bond.GetEndAtom().GetSymbol() == "H":
+            h_atom_idx = bond.GetEndAtomIdx()
+            break
+
+    mw.RemoveAtom(h_atom_idx)
+    mw.CommitBatchEdit()
+    return mw
