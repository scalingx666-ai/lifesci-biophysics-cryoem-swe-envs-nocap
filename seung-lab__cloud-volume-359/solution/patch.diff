+def sip(iterable, block_size):
+  """Sips a fixed size from the iterable."""
+  ct = 0
+  block = []
+  for x in iterable:
+    ct += 1
+    block.append(x)
+    if ct == block_size:
+      yield block
+      ct = 0
+      block = []
+
+  if len(block) > 0:
+    yield block
+
