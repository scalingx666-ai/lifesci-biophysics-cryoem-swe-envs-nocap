-def compute_conf_bounds(X):
-    df = len(X) - 1  # degrees of freedom = n-1
-    critical_value = t_dist.ppf(CONFIDENCE, df)
-    return np.mean(X) + critical_value * np.std(X, ddof=1)  # sample std
