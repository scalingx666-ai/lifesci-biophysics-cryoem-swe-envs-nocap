-
-# Every runtime test needs to have the following structure:
-#
-# @compare_to_baseline()
-# def test_runtime_of_x(**kwargs) -> Dict:
-#   t1 = time.time()
-#   time.sleep(0.1)
-#   # do something
-#   t2 = time.time()
-#   # do something else
-#   t3 = time.time()
