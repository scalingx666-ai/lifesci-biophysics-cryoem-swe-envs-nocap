+function Model(m::Model, structure::StructuralElement)
+    chains = Dict{String, Chain}()
+    mnew = Model(m.number, chains, structure)
+    for (id, ch) in m.chains
+        chains[id] = Chain(ch, mnew)
+    end
+    return mnew
+end
 
