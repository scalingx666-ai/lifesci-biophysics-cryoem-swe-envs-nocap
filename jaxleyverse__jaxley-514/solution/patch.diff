-        inds_of_comps = list(
+        comp_inds = list(
             grouped_view.apply(lambda x: x.index.values, include_groups=False)
         )
-        indices_per_param = jnp.stack(inds_of_comps)
+
+        # check if all shapes in comp_inds are the same. If not the case this means
