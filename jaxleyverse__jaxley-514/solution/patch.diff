+        lens = np.array([inds.shape[0] for inds in comp_inds])
+        max_len = np.max(lens)
+        pad = lambda x: np.pad(x, (0, max_len - x.shape[0]), constant_values=-1)
+        if not np.all(lens == max_len):
+            comp_inds = [
