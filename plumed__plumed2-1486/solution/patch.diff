diff --git a/regtest/ttsketch/rt-ttmetad-walkers-dd/config b/regtest/ttsketch/rt-ttmetad-walkers-dd/config
new file mode 100644
index 0000000000..59559d4d97
--- /dev/null
+++ b/regtest/ttsketch/rt-ttmetad-walkers-dd/config
@@ -0,0 +1,12 @@
+mpiprocs=4
+type=driver
+plumed_modules=ttsketch
+plumed_needs=libitensor
+# two MPI walkers with two ranks each, under a fake domain decomposition;
+# walker 1 reads traj.1.gro, the same frames in reverse order
+arg="--plumed plumed.dat --trajectory-stride 500 --timestep 0.002 --igro traj.gro --multi 2 --debug-dd yes --dump-forces forces --dump-forces-fmt %.4lf"
+
+# with WALKERS_MPI the shared sketch file is written one level up
+function plumed_regtest_after(){
+  rm -f ../ttsketch.h5
+}
