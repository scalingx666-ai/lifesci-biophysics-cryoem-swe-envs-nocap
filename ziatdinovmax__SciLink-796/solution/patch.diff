+         "run_order": ["hcn.nw", "hnc.nw"]}
+    resolve_run_order(r)
+    phases = _collect_phases(r, "/tmp/x", "nwchem {script}")
+    assert [p.run_command for p in phases] == ["nwchem hcn.nw", "nwchem hnc.nw"]
+    assert all(p.run_dir == "/tmp/x" for p in phases)
