+_WATER = "3\nwater\nO 0 0 0.117\nH 0 0.757 -0.469\nH 0 -0.757 -0.469\n"
+_DECK = ("start {n}\ngeometry\n O 0 0 0.117\n H 0 0.757 -0.469\n"
