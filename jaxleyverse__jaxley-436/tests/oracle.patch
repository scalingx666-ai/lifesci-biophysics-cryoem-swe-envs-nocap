+    branch1 = jx.Branch(comp, nseg=4)
+    branch1.comp(2).insert(HH())
+    cell = jx.Cell([branch0, branch1], parents=[-1, 0])
+    with pytest.raises(ValueError):
+        cell.branch(1).set_ncomp(2)
