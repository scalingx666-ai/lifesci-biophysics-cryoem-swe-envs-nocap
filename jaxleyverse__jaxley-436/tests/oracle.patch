+def cumsum_leading_zero(array: Union[jnp.ndarray, List]) -> jnp.ndarray:
+    """Return the `cumsum` of a jax array and pad with a leading zero."""
+    return jnp.concatenate([jnp.asarray([0]), jnp.cumsum(jnp.asarray(array))]).astype(
+        int
+    )
