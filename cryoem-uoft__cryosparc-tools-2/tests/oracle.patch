+
+	fail:
+	// Delete and invalidate dataset
+	if (dset) dset_del(dset);
+	dset = UINT64_MAX;
+
+	done:
+	// Clean up hash table
+	// Free up memoized column data, if necessary
+	ht64_del(&idx_lookup);
+	if (src_coldata != src_coldata_stack) DSFREE(src_coldata);
+
+	return dset;
+}
