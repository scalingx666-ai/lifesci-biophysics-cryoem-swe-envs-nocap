+                composition_interval=ci,
+                fit_order=kw.get('fit_order', 4),
+                method=kw.get('method', 'polynomial'),
+                end_weight=kw.get('end_weight', 3),
+                end_indices=kw.get('end_indices', 4),
+            )
+            if d is not None:
+                dict_list.append(d)
+
+        if len(dict_list) == 0:
