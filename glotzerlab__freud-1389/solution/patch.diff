+            if (!m_box.is2D())
+            {
+                min_plane_distance = std::min(min_plane_distance, nearest_plane_distance.z);
+            }
+
+            args.r_guess = std::min(r_guess, min_plane_distance / 2.0F);
+        }
+        args.r_guess = std::min(args.r_guess, args.r_max);
+    }
