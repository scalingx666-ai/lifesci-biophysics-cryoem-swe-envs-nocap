+
+    # An existing empty file gets a header, without a warning
+    rm(path)
+    touch(path)
+    md_1 = @test_logs Metadynamics(ListHills((dist,), 1.0, 0.1);
+                        logger=MetadynamicsLogger(temperature=T, cv_points=pts, filepath=path))
+    add_hill!(md_1, 0.5)
