+    add_hill!(md_g, 0.55u"nm")
+    @test unit(md_g.logger.offsets[2]) == u"kJ * mol^-1"
+    @test sum(metadynamics_weights(md_g.logger)) ≈ 1
+
+    # Records go to the file in batches of write_interval, flush writes the rest
