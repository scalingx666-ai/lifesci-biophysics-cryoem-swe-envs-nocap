+    # An affine temperature (°C) gets the same clear error
+    @test_throws ArgumentError Metadynamics(ListHills((dist,), 1.0u"kJ * mol^-1", 0.1u"nm");
+                                            tempering=WellTempered(γ, 25u"°C"))
+
+    # 2-CV cv_points from Iterators.product
