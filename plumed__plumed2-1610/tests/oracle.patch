+  # Regtests (no MPI, no optional libraries) on configurations that the jobs above do not cover:
+  # - clang-noopenmp: the configuration built in the gate (build job of checksWF.yml, where its warnings
+  #   are checked). Run with PLUMED_NUM_THREADS=2 like the other jobs, so the code paths of OpenMP builds
+  #   that do not depend on OpenMP are tested without it. It restores the ccache saved by the gate, so it
+  #   does not compile again: keep the cache key and the configure options in sync with checksWF.yml.
+  # - nodlopen: --disable-dlopen (LOAD and the runtime loading of the kernel are not available).
+  checks:
+    runs-on: ubuntu-24.04
+    strategy:
+      fail-fast: false
+      matrix:
+        include:
+        - variant: clang-noopenmp
