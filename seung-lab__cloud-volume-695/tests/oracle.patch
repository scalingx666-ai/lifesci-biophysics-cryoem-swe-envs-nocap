 def getsizeof(val:Union[int,str,bytes,list,tuple]) -> int:
   """does sizeof at arbitrary depth for tuples and lists"""
   nbytes = 0
   if isinstance(val, (tuple, list)):
     for elem in val:
       nbytes += getsizeof(elem)
+  elif isinstance(val, np.ndarray):
