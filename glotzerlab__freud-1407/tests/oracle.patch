diff --git a/prek.toml b/prek.toml
new file mode 100644
index 000000000..a179d6051
--- /dev/null
+++ b/prek.toml
@@ -0,0 +1,114 @@
+#:schema https://www.schemastore.org/prek.json
+
+minimum_prek_version = "0.3.8"
+
+exclude = "(?:^extern/)"
+
+[[repos]]
+repo = "builtin"
+hooks = [
+  {
+    id = "end-of-file-fixer",
+    exclude = '''
+(?x)^(
+  ^.*\.ai|
+  ^.*\.txt\
+  ^extern/
+)
+'''
+  },
+  {
+    id = "trailing-whitespace",
+    exclude = '''
+(?x)^(
+  ^.*\.ai|
+  ^.*\.txt|
+  ^extern/|
+  ^setup.cfg
+)
+'''
+  },
+  { id = "check-executables-have-shebangs" },
+  { id = "check-json" },
+  { id = "check-toml" },
+  {
+    id = "check-yaml",
+    exclude = '\.clang-format'
+  },
+  { id = "check-case-conflict" },
+  { id = "mixed-line-ending" },
+  { id = "check-added-large-files" },
+  { id = "check-symlinks" },
+  { id = "detect-private-key" },
+  { id = "check-vcs-permalinks" },
+  { id = "check-shebang-scripts-are-executable" },
+  { id = "check-illegal-windows-names" },
+]
+
+[[repos]]
+repo = "https://github.com/glotzerlab/fix-license-header"
+rev = "v0.4.1"
+hooks = [
+  {
+    id = "fix-license-header",
+    name = "Fix License Headers (Python)",
+    exclude = """
+(?x)(
+    ^doc/|
+    ^extern/
+    )
+""",
+    types_or = [
+      "c",
+      "c++",
+      "python"
+    ],
+    args = [
+      "--license-file=LICENSE",
+      "--start=2",
+      "--num=1",
+      "--add=This file is from the freud project, released under the BSD 3-Clause License.",
+      "--keep-before=#!"
+    ]
+  }
+]
+
+[[repos]]
+repo = "https://github.com/astral-sh/ruff-pre-commit"
+rev = "v0.14.0"
+hooks = [
+  { id = "ruff-format" },
+  { id = "ruff-check" }
+]
+
+[[repos]]
+repo = "https://github.com/cheshirekow/cmake-format-precommit"
+rev = "v0.6.13"
+hooks = [
+  { id = "cmake-format" }
+]
+
+[[repos]]
+repo = "https://github.com/pre-commit/mirrors-clang-format"
+rev = "v21.1.2"
+hooks = [
+  {
+    id = "clang-format",
+    types_or = [
+      "c",
+      "c++"
+    ]
+  }
+]
+
+[[repos]]
+repo = "https://github.com/mit-d/check-unicode"
+rev = "v0.5.0"
+hooks = [
+  { id = "check-unicode",
+    args = [
+      "--allow-printable",
+      "--check-confusables",
+    ]
+  }
+]
