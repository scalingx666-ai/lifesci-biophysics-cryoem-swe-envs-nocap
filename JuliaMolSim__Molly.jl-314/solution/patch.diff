+# Damped Newton-Raphson solver (Shirts and Chodera 2008, Appendix C2) for the MBAR free
+#   energies of the sampled states. The free energies minimize the convex function
+#     F(f) = ∑_n log D_n - ∑_j N_j f_j,   D_n = ∑_j N_j exp(f_j - u[n,j]),
+#   which is unchanged when all f_j are shifted together, so the first sampled state is held
+#   fixed. With the posterior weights P[j,n] = N_j exp(f_j - u[n,j]) / D_n and s_j = ∑_n P[j,n],
+#   the gradient is g_j = s_j - N_j and the Hessian is H = diag(s) - P Pᵀ. The normalization
+#   residual g_j / N_j = ∑_n W[n,j] - 1 vanishes at the solution.
+
+# One pass over the frames at `a = logN + f` of the sampled states: fills `logD`, the
+#   posterior weights `P` (sampled states × frames) and their sums `s`
+function mbar_newton_pass!(logD, P, s, u, a, sampled)
+    Ks = length(sampled)
+    Threads.@threads for n in axes(u, 1)
+        m = -Inf
+        @inbounds for j in 1:Ks
+            m = max(m, a[j] - u[n, sampled[j]])
+        end
+        se = 0.0
+        @inbounds for j in 1:Ks
+            e = exp(a[j] - u[n, sampled[j]] - m)
+            P[j, n] = e
+            se += e
+        end
+        logD[n] = m + log(se)
+        inv_se = inv(se)
+        @inbounds for j in 1:Ks
+            P[j, n] *= inv_se
+        end
+    end
+    sum!(s, P)
+    return logD
+end
+
+mbar_residual(s, Ns) = maximum(j -> abs(s[j] / Ns[j] - 1), eachindex(s))
+
+# Self-consistent step of Eq C3 for the sampled states, f_j ← f_j - log(∑_n W[n,j]), gauged
+#   to the first sampled state. States whose posterior weights sum to a value near underflow
+#   use the log-sum-exp form, which stays finite far from the solution.
+function mbar_newton_fixed_point_step!(step, s, Ns, u, a, logD, sampled)
+    Threads.@threads for j in eachindex(sampled)
+        if s[j] > sqrt(floatmin(Float64))
+            step[j] = -log(s[j] / Ns[j])
+        else
+            k = sampled[j]
+            m = -Inf
+            @inbounds for n in axes(u, 1)
+                m = max(m, a[j] - u[n, k] - logD[n])
+            end
+            se = 0.0
+            @inbounds for n in axes(u, 1)
+                se += exp(a[j] - u[n, k] - logD[n] - m)
+            end
+            step[j] = -(m + log(se) - log(Ns[j]))
+        end
+    end
+    step .-= step[1]
+    return step
+end
+
+# Returns the free energies of all K states, gauge-fixed to f[1] = 0, and a named tuple with
+#   the number of iterations, the number of fixed-point steps taken in place of Newton steps
+#   and the final normalization residual
+function mbar_newton(u::AbstractMatrix, f_init::AbstractVector, N_counts::AbstractVector,
+                     logN::AbstractVector; atol=1e-10, max_iter::Integer=10_000)
+    N, K = size(u)
+    sampled = findall(>(0), N_counts)
+    Ks = length(sampled)
+    Ns = Float64.(N_counts[sampled])
+    logNs = logN[sampled]
+
+    f = Float64.(f_init[sampled])
+    f .-= f[1]
+    trial, step, g, a = similar(f), similar(f), similar(f), similar(f)
+    logD, logD_trial = Vector{Float64}(undef, N), Vector{Float64}(undef, N)
+    P, P_trial = Matrix{Float64}(undef, Ks, N), Matrix{Float64}(undef, Ks, N)
+    s, s_trial = similar(f), similar(f)
+    PPt = Matrix{Float64}(undef, Ks, Ks)
+    M = Matrix{Float64}(undef, Ks - 1, Ks - 1)
+
+    a .= logNs .+ f
+    mbar_newton_pass!(logD, P, s, u, a, sampled)
+    residual = mbar_residual(s, Ns)
+    μ = 1e-6 # Levenberg-Marquardt damping, relative to the Hessian diagonal
+    iter, n_fixed_point = 0, 0
+    at_floor = false
+    while residual > atol && iter < max_iter
+        iter += 1
+        g .= s .- Ns
+        mul!(PPt, P, transpose(P))
+        # Objective differences below this are rounding error, so near the solution a step
+        #   must halve the normalization residual instead
+        noise = sum(abs, logD)
+        @inbounds for j in 1:Ks
+            noise += abs(Ns[j] * f[j])
+        end
+        noise *= 8 * eps(Float64)
+        accepted = false
+        ΔF, residual_trial = 0.0, Inf
+        for _ in 1:2
+            d_max = 0.0
+            @inbounds for j in 2:Ks, i in 2:Ks
+                M[i-1, j-1] = (i == j ? s[i] : 0.0) - PPt[i, j]
+                i == j && (d_max = max(d_max, M[i-1, i-1]))
+            end
+            @inbounds for i in 1:(Ks - 1)
+                M[i, i] += μ * (M[i, i] + 1e-12 * d_max)
+            end
+            C = cholesky!(Symmetric(M), check=false)
+            if !issuccess(C)
+                μ *= 10
+                continue
+            end
+            step[1] = 0.0
+            ldiv!(view(step, 2:Ks), C, view(g, 2:Ks))
+            step .*= -1
+            ΔF, residual_trial = mbar_newton_trial!(logD_trial, P_trial, s_trial, trial, a,
+                                                    u, f, step, logD, logNs, Ns, sampled)
+            # Armijo condition with a decrease above rounding error, or a lower residual where
+            #   the objective change is rounding error
+            if (ΔF ≤ 1e-4 * dot(g, step) && ΔF < -noise) ||
+                    (abs(ΔF) ≤ noise && residual_trial < residual / 2)
+                accepted = true
+                μ = max(μ / 10, 1e-12)
+                break
+            end
+            μ *= 4
+        end
+        if !accepted
+            a .= logNs .+ f
+            mbar_newton_fixed_point_step!(step, s, Ns, u, a, logD, sampled)
+            ΔF, residual_trial = mbar_newton_trial!(logD_trial, P_trial, s_trial, trial, a,
+                                                    u, f, step, logD, logNs, Ns, sampled)
+            # Neither step makes progress at the rounding level, so stop
+            if !(ΔF < -noise || residual_trial < residual / 2)
+                at_floor = true
+                break
+            end
+            n_fixed_point += 1
+        end
+        f, trial = trial, f
+        logD, logD_trial = logD_trial, logD
+        P, P_trial = P_trial, P
+        s, s_trial = s_trial, s
+        residual = residual_trial
+    end
+    if at_floor && !(residual ≤ atol)
+        @warn "MBAR Newton solver reached the rounding floor after $iter iterations with " *
+              "normalization residual $residual > atol ($atol), raise atol to at least the floor"
+    elseif !(residual ≤ atol)
+        @warn "MBAR Newton solver stopped at max_iter ($max_iter) with normalization " *
+              "residual $residual > atol ($atol)"
+    end
+
+    f_all = zeros(Float64, K)
+    f_all[sampled] .= f
+    mbar_unsampled_f!(f_all, u, logD, findall(iszero, N_counts))
+    f_all .-= f_all[1]
+    return f_all, (iterations=iter, fixed_point_steps=n_fixed_point, residual=residual)
+end
+
+# Unsampled states follow from the MBAR equation at the solved free energies
+function mbar_unsampled_f!(f, u, logD, unsampled)
+    Threads.@threads for k in unsampled
+        m = -Inf
+        @inbounds for n in axes(u, 1)
+            m = max(m, -u[n, k] - logD[n])
+        end
+        se = 0.0
+        @inbounds for n in axes(u, 1)
+            se += exp(-u[n, k] - logD[n] - m)
+        end
+        f[k] = -(m + log(se))
+    end
+    return f
+end
+
+# Evaluates the trial point f + step, returning the change of the objective and the residual.
+#   `step` is replaced by the step actually applied after rounding, which differs from the
+#   computed one when it is small against `f`.
+function mbar_newton_trial!(logD_trial, P_trial, s_trial, trial, a, u, f, step, logD, logNs,
+                            Ns, sampled)
+    trial .= f .+ step
+    step .= trial .- f
+    a .= logNs .+ trial
+    mbar_newton_pass!(logD_trial, P_trial, s_trial, u, a, sampled)
+    ΔF = 0.0
+    @inbounds for n in eachindex(logD)
+        ΔF += logD_trial[n] - logD[n]
+    end
+    ΔF -= dot(Ns, step)
+    return ΔF, mbar_residual(s_trial, Ns)
+end
