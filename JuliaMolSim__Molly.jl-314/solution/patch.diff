+# Check that `win_of` and `N_counts` describe the same N frames of K states
+function mbar_check_counts(win_of::AbstractVector{<:Integer}, N_counts::AbstractVector{<:Integer},
+                           N::Integer, K::Integer)
+    if length(win_of) != N
+        throw(ArgumentError("length of win_of ($(length(win_of))) must equal number " *
+                            "of columns in u ($N)"))
+    end
+    if length(N_counts) != K
+        throw(ArgumentError("N_counts ($N_counts) must have length $K"))
+    end
+    counts = zeros(Int, K)
+    @inbounds for n in 1:N
+        k = win_of[n]
+        if !(1 ≤ k ≤ K)
+            throw(ArgumentError("win_of contains invalid state index $k"))
+        end
+        counts[k] += 1
+    end
+    if !(counts == N_counts)
+        throw(ArgumentError("counts derived from win_of differ from N_counts"))
+    end
+    if N == 0
+        throw(ArgumentError("no frames given"))
+    end
+    return nothing
+end
