diff --git a/libtbx/SConscript b/libtbx/SConscript
index bcfd53ead7f..f7404ec859c 100644
--- a/libtbx/SConscript
+++ b/libtbx/SConscript
@@ -1487,6 +1487,16 @@ def enable_cuda_if_possible():
                         '--generate-code=arch=compute_72,code=sm_72',
                         '--generate-code=arch=compute_75,code=sm_75']
 
+    # CUDA 13 dropped Maxwell, Pascal and Volta; the oldest real target is sm_75
+    elif cuda_version >= 13:
+        arch_flags = ['--generate-code=arch=compute_75,code=sm_75',
+                      '--generate-code=arch=compute_80,code=sm_80',
+                      '--generate-code=arch=compute_86,code=sm_86',
+                      '--generate-code=arch=compute_89,code=sm_89',
+                      '--generate-code=arch=compute_90,code=sm_90',
+                      # PTX only, JIT-compiled by the driver on newer hardware
+                      '--generate-code=arch=compute_90,code=compute_90']
+
     elif cuda_version >= 11:  # NOTE: lower compute compat. are being phased out
         arch_flags = ['--generate-code=arch=compute_60,code=sm_60',
                       '--generate-code=arch=compute_61,code=sm_61',
@@ -1500,7 +1510,7 @@ def enable_cuda_if_possible():
         if cuda_version < 11.1:
             arch_flags.pop()
     else:
-        raise Sorry("cctbx only supports cuda versions 6-11")
+        raise Sorry("cctbx only supports cuda versions 6-13")
 
     env_base['NVCC'] = 'nvcc'
     linker_flags = env_base['SHLINKFLAGS']
