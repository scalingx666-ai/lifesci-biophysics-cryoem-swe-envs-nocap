diff --git a/.github/workflows/version-maintenance.yml b/.github/workflows/version-maintenance.yml
index 12ca044b0..261c373be 100644
--- a/.github/workflows/version-maintenance.yml
+++ b/.github/workflows/version-maintenance.yml
@@ -4,13 +4,44 @@ on:
   push:
     branches:
       - master
+  pull_request_target:
+    types:
+      - closed
+    branches:
+      - master
 
 jobs:
 
+  update-versions:
+    name: Update version strings
+    runs-on: ubuntu-latest
+    if: ${{ github.repository == 'Colvars/colvars' && github.event_name == 'pull_request_target' && github.event.pull_request.merged == true }}
+    concurrency:
+      group: update-version-strings-master
+      cancel-in-progress: false
+    steps:
+
+      - name: Checkout Colvars repo in full
+        uses: actions/checkout@v7
+        with:
+          ref: master
+          fetch-depth: 0
+          ssh-key: ${{ secrets.PULL_PUSH_COLVARS_KEY }}
+
+      - name: Update version strings
+        env:
+          LAST_COMMIT_BEFORE_MERGE: ${{ github.event.pull_request.base.sha }}
+        run: |
+          git config user.email "noreply@github.com"
+          git config user.name "CI runner"
+          source devel-tools/version_functions.sh
+          update_all_versions "${LAST_COMMIT_BEFORE_MERGE}"
+          git push origin master
+
   update-wiki:
     name: Update Wiki repo
     runs-on: ubuntu-latest
-    if: ${{ github.repository == 'Colvars/colvars' }}
+    if: ${{ github.repository == 'Colvars/colvars' && github.event_name == 'push' }}
     steps:
 
       - name: Checkout Colvars repo in full
diff --git a/devel-tools/version_functions.sh b/devel-tools/version_functions.sh
index b05a93733..d93d2db26 100644
--- a/devel-tools/version_functions.sh
+++ b/devel-tools/version_functions.sh
@@ -226,9 +226,16 @@ update_all_versions() {
                           get_cv_dashboard_version \
                           none \
                           vmd/cv_dashboard/VERSION \
-                          ${branch} \
-        && \
-    git commit -m "Update version strings" -m "[update-doc]"
+                          ${branch}
+
+    local retval=$?
+    if [ $retval == 0 ] ; then
+        if ! git diff --cached --quiet ; then
+            git commit -m "Update version strings" -m "[update-doc]"
+        fi
+    else
+        return $retval
+    fi
 }
 
 
