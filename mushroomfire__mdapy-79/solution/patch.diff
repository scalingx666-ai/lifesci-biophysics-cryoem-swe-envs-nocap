+@pytest.mark.parametrize(
+    "kind, repeat, dissociation, angle, spread",
+    [
+        ("fcc screw", (6, 14, 4), 0, 0.0, 2.0),
+        ("fcc edge", (14, 8, 4), 0, 90.0, 2.0),
+        # Shockley partials of 30 and 60 degrees
