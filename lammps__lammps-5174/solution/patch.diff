+template<class DeviceType>
+template<int NDENSITY>
+// NOLINTNEXTLINE
+KOKKOS_INLINE_FUNCTION
+void PairPACEKokkos<DeviceType>::rho_fs_weights_cpu(const int ii) const
+{
+  const int i = d_ilist[ii + chunk_offset];
