+  const int *wmoff = b.wm_off + idx_ms_combs * b.rankmax;
+  const complex *dB = b.dB + b.dB_off[idx_ms_combs];
+  const KK_FLOAT *ct = b.ctildes + idx_ms_combs * b.ndensitymax;
