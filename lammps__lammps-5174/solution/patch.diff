+    const int ndl = NDENSITY ? NDENSITY : ndensity;
+    for (int k = 0; k < nb; k++) {
+      KK_FLOAT theta = 0.0;
+      for (int p = 0; p < ndl; ++p) theta += bl[k].dF[p] * ct[p];
+      bl[k].w_rank1[ro] += theta;
+    }
+  }
