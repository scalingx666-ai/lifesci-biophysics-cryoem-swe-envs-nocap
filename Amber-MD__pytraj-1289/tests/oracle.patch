+def select_atoms(mask, topology):
+    '''return atom indices
+
+    Examples
+    --------
+    >>> import pytraj as pt
+    >>> traj = pt.datafiles.load_tz2_ortho()
+    >>> atom_indices = pt.select_atoms('@CA', traj.top)
+    >>> atom_indices
+    array([  4,  15,  39, ..., 159, 173, 197])
+    >>> pt.select_atoms(traj.top, '@CA')
+    array([  4,  15,  39, ..., 159, 173, 197])
