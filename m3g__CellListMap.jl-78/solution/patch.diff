+        S(m[:, 1] + m[:, 2]),
+        S(m[:, 2]),
+        S(0.0, 0.0, 0.0),
+        S(m[:, 1]),
+        S(m[:, 1] + m[:, 3]),
+        S(m[:, 3]),
+        S(0.0, 0.0, 0.0),
+        S(m[:, 2]),
+        S(m[:, 2] + m[:, 3]),
+        S(m[:, 2]),
+        S(0.0, 0.0, 0.0),
+        S(m[:, 1]),
+        S(m[:, 1] + m[:, 2]),
+        S(m[:, 1] + m[:, 2]) + m[:, 3],
+        S(m[:, 1] + m[:, 3]),
