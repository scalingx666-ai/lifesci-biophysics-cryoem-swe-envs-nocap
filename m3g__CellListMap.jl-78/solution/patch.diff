+
+    m = @SMatrix[1.0 0.0; 0.0 1.0]
+    @test align_cell(m) == (one(m), one(m))
+
+    m = @SMatrix[l 0; l 1]
+    mt, R = align_cell(m)
+    @test mt ≈ [1 l; 0 l]
