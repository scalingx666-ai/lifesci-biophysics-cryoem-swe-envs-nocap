-		*ret = 0;
-		return;
-	}
-	if (ftocstr(cstr, len+1, str, len)) {
-		*ret = 0;
-		cstr=(char *)condfree(cstr);
-		return;
-	}
-
-	*ret = xdrfile_read_string(cstr, len+1,f77xdr[*fid]);
-	ctofstr( str, len , cstr);
-	cstr=(char *)condfree(cstr);
-}
