-static int ftocstr(char *dest, int destlen, char *src, int srclen)
-{
-    char *p;
-
-    p = src + srclen;
-    while ( --p >= src && *p == ' ' );
-    srclen = p - src + 1;
-    destlen--;
-    dest[0] = 0;
-    if (srclen > destlen)
-		return 1;
-    while (srclen--)
-		(*dest++ = *src++);
-    *dest = '\0';
-    return 0;
-}
-
-
-static int ctofstr(char *dest, int destlen, char *src)
-{
-    while (destlen && *src) {
-        *dest++ = *src++;
-        destlen--;
-    }
-    while (destlen--)
-        *dest++ = ' ';
-    return 0;
-}
-
