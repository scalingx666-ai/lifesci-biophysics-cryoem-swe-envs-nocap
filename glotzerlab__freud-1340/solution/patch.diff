diff --git a/.github/workflows/cibuildwheel-repair-wheel.ps1 b/.github/workflows/cibuildwheel-repair-wheel.ps1
new file mode 100644
index 000000000..e31e3f1be
--- /dev/null
+++ b/.github/workflows/cibuildwheel-repair-wheel.ps1
@@ -0,0 +1,8 @@
+$DEST_DIR = $args[0]
+$WHEEL = $args[1]
+
+# Install delvewheel for Windows wheel repairs
+pip install delvewheel==1.11.0
+
+# From https://cibuildwheel.pypa.io/en/stable/options/#repair-wheel-command
+delvewheel repair --add-path "C:/Program Files (x86)/TBB/bin/" -w "${DEST_DIR}" "${WHEEL}"
