+    assert(lattice.get_ghost_layers() == 1u);
+    return [&](Utils::Vector3d const &pos, Utils::Vector3d const &force) {
+      if (not get_block_extended(lattice, pos, 1u)) {
+        return;
+      }
+      auto const zc_conv = FloatType{1} / m_density; // zero-centered fields
