+      if axis["type"] != "space":
+        continue
+      
+      if axis["name"] == "x":
+        scale_factors[0] = spatial_unit_in_meters(axis.get("unit", "nanometer"))
+        positions[0] = i
+      elif axis["name"] == "y":
+        scale_factors[1] = spatial_unit_in_meters(axis.get("unit", "nanometer"))
+        positions[1] = i
+      elif axis["name"] == "z":
