-def get_dist_from_R(R):
-    """ returns prediction offset, R is reflection table"""
-    x, y, _ = R['xyzobs.px.value'].parts()
-    x2, y2, _ = R['xyzcal.px'].parts()
-    dist = np.sqrt((x - x2) ** 2 + (y - y2) ** 2)
-    return dist
