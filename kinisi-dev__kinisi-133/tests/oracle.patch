+        _, logdet = np.linalg.slogdet(covariance_matrix)
+        logdet += np.log(2 * np.pi) * y_values.size
+        inv = pinvh(covariance_matrix)
+
+        diff = model - y_values
+        logl = -0.5 * (logdet + np.matmul(diff.T, np.matmul(inv, diff)))
