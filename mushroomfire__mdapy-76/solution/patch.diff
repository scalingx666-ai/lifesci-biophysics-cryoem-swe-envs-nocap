+# --------------------------------------------------------------- reading
+
+# the structures by their short and full names in OVITO's files, in any case
+_ALIASES = {
+    alias.lower(): name
+    for name, aliases in {
+        "fcc": ("fcc", "FCC", "Face-centered cubic"),
+        "hcp": ("hcp", "HCP", "Hexagonal close-packed"),
+        "bcc": ("bcc", "BCC", "Body-centered cubic"),
