+function DistanceMap(el::StructuralElementOrList)
+    dists = zeros(length(el), length(el))
+    el_list = collect(el)
+    for i in 1:length(el)
+        for j in 1:i-1
+            dist = distance(el_list[i], el_list[j])
+            dists[i, j] = dist
+            dists[j, i] = dist
+        end
+    end
+    return DistanceMap(dists)
