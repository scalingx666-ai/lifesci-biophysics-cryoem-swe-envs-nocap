+@pytest.mark.parametrize("skin,skew,charge,multiplicity", [(1.0, False, 0, 1), (0.0, True, 1, 2)],
+                         ids=["thin", "triclinic"])
+def test_thin_and_triclinic_cells_take_exact_images(skin, skew, charge, multiplicity):
