+
+    def test_ase_interface_none_type_mapping(self):
+        """Test ASE interface creation with type_mapping=None."""
+        ase_interface = espressomd.plugins.ase.ASEInterface(
+            system=system,
+            type_mapping=None,
+            particle_slice=system.part.all()
