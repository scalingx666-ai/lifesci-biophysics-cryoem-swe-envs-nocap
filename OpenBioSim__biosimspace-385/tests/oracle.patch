+
+    # Documentation strings.
+    _doc_strings = {
+        "KILOGRAM": "A mass in kilogram.",
+        "GRAM": "A mass in gram.",
+        "MILLIGRAM": "A mass in milligram.",
+        "MICROGRAM": "A mass in microgram.",
