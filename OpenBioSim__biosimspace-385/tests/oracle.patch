+        elif unit == "MILLIGRAM":
+            return self.milligram()
+        elif unit == "MICROGRAM":
+            return self.microgram()
+        elif unit == "NANOGRAM":
+            return self.nanogram()
+        elif unit == "PICOGRAM":
+            return self.picogram()
+        elif unit == "FEMTOGRAM":
+            return self.femtogram()
