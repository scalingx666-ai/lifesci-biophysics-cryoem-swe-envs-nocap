-    doc_pattern = """.*?(?P<DOCS>DESCRIPTION.*)"""
-    gmxfatal_pattern = """----+\n                   # ---- decorator line
-            \s*Program\s+(?P<program_name>\w+),     #  Program name,
-              \s+VERSION\s+(?P<version>[\w.]+)\s*\n #    VERSION 4.0.5
