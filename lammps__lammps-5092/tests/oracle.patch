+        mc = position_to_bin(xcont);
+        if (mc < 0) continue;
+
+        if (chunk_reducedflag) {
+          double lamda[3];
+          domain->x2lamda(xcont, lamda);
+          for (a = 0; a < chunk_ncoord; a++) lamda[cdim[a]] = coord[mc][a];
