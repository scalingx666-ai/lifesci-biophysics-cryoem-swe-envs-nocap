+
+  // Calculate trivially derived values, in the order used
+
+  // velocity
+  double dtemp;
+  for (m = 0; m < nchunk; m++) {
+    field_index = 0;
+    for (auto &val : values) {
+      style = std::get<0>(val);
+      vtype = std::get<1>(val);
+      component = std::get<2>(val);
+
+      if (vtype == 1) {
+        a = component;
+      } else {
+        a = component / 3;
+        b = component % 3;
+      }
+
