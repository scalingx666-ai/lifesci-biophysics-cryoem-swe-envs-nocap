+
+        # Lambda = 1 state has a zero sigma value.
+        if abs(lj1.sigma().value()) <= null_lj_sigma:
+            # Use the sigma value from the lambda = 0 state.
+            edit_mol = (
+                edit_mol.atom(atom.index())
