+        # Get the end state LJ sigma values.
+        lj0 = atom.property("LJ0")
+        lj1 = atom.property("LJ1")
+
+        # Lambda = 0 state has a zero sigma value.
+        if abs(lj0.sigma().value()) <= null_lj_sigma:
+            # Use the sigma value from the lambda = 1 state.
