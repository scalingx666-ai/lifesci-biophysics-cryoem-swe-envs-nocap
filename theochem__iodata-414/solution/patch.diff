+def test_title_starting_with_hash(tmpdir):
+    # A comment line outside a section starts with "#", but a title may start with it too.
+    with as_file(files("iodata.test.data").joinpath("water_sto3g_hf.wfx")) as file_name:
+        mol1 = load_one(str(file_name))
+    mol1.title = "# Generated by Multiwfn"
+    fn_tmp = os.path.join(tmpdir, "foo.wfx")
+    dump_one(mol1, fn_tmp)
+    mol2 = load_one(fn_tmp)
+    assert mol2.title == "# Generated by Multiwfn"
