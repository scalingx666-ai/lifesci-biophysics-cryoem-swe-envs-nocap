+    if (copies) {
+        copy = to_array(std::move(atoms.copy), {n});
+    }
+    if (margin >= 0.0) {
+        edge = to_array(std::move(atoms.edge), {n});
+    }
+    return nb::make_tuple(to_array(std::move(atoms.positions), {n, 3}),
+                          to_array(std::move(atoms.grain), {n}),
+                          to_array(std::move(atoms.site), {n}), copy, edge);
+}
