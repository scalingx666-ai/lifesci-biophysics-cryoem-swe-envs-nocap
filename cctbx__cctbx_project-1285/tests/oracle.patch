+def exercise_protonated_water_kept():
+  """A water that already has two H is left exactly as-is, as is a blank O
+  carrying two D in each of altlocs A and B.
+
+  Places on ``_PROTONATED_WATER_PDB`` and ``_ALTLOC_D_WATER_PDB`` with the
+  defaults and compares every atom name and site.
+  """
+  for pdb_str in (_PROTONATED_WATER_PDB, _ALTLOC_D_WATER_PDB):
+    hier = _hierarchy(pdb_str)
+    before = [(a.name.strip(), tuple(a.xyz)) for a in hier.atoms()]
+    wp.place_water_hydrogens(hier)
+    after = [(a.name.strip(), tuple(a.xyz)) for a in hier.atoms()]
+    assert after == before, (
+      f"already-protonated water must be untouched:\n{before}\n{after}")
+
+
+def exercise_n_acceptors():
+  """An N that already carries an H is a donor, and one bonded to three
+  heavy atoms in a plane has no free lone pair: H1 skips such a nearer N and
+  points at the farther bare N instead. A nearer pyramidal N, bonded to
+  three C, is an acceptor and takes H1, as does a nearer N whose H belongs
+  to an altloc the water never meets.
+
+  Places on ``_DONOR_N_PDB``, ``_PLANAR_N_PDB``, ``_METAL_N_PDB`` (two C
+  and a Zn), ``_PYRAMIDAL_N_PDB``, ``_ALTLOC_DONOR_N_PDB`` and
+  ``_BLANK_N_ALTLOC_H_PDB`` (H in another altloc than the water), and
+  ``_BLANK_N_SAME_ALTLOC_H_PDB`` (H in the water's altloc).
+  """
+  far = matrix.col((-1.0, 0.0, 0.0))   # toward the farther bare N
+  near = matrix.col((1.0, 0.0, 0.0))   # toward the nearer N
+  for pdb_str, nearer, near_accepts in (
+      (_DONOR_N_PDB, "DNR", False),
+      (_PLANAR_N_PDB, "PLN", False),
+      (_METAL_N_PDB, "MTN", False),
+      (_PYRAMIDAL_N_PDB, "PYN", True),
+      (_ALTLOC_DONOR_N_PDB, "altloc B DNR", True),
+      (_BLANK_N_ALTLOC_H_PDB, "blank DNR, H in altloc A", True),
+      (_BLANK_N_SAME_ALTLOC_H_PDB, "blank DNR, H in the altloc", False)):
+    hier = _hierarchy(pdb_str)
+    wp.place_water_hydrogens(hier, n_refine=0)
+    o, hs = _water_atoms(hier)
+    dirs = [(matrix.col(h.xyz) - matrix.col(o.xyz)).normalize()
+            for h in hs.values()]
+    best_far = max(d.dot(far) for d in dirs)
+    best_near = max(d.dot(near) for d in dirs)
+    if near_accepts:
+      assert best_near > 0.9, f"no H points at {nearer} N ({best_near:.3f})"
+    else:
+      assert best_far > 0.9, (
+        f"{nearer}: no H points at the bare N ({best_far:.3f})")
+      assert best_near < 0.9, f"an H points at {nearer} N ({best_near:.3f})"
+
+
+def exercise_reorient_existing():
+  """``existing_h="reorient"`` strips the existing (mis-oriented) H and
+  re-places them toward the acceptor; the default leaves them as-is.
+
+  Places on ``_BAD_PROTONATED_PDB`` with the default and with
+  ``existing_h="reorient"``.
+  """
+  acc = matrix.col((2.700, 0.000, 0.000))
+
+  def best_align(hier):
+    o, hs = _water_atoms(hier)
+    return max((matrix.col(h.xyz) - matrix.col(o.xyz)).normalize().dot(
+                 (acc - matrix.col(o.xyz)).normalize()) for h in hs.values())
+
+  kept = _hierarchy(_BAD_PROTONATED_PDB)
+  wp.place_water_hydrogens(kept, n_refine=0)
+  align = best_align(kept)
+  assert align < 0.5, (
+    f"default run must not reorient existing H toward the acceptor "
+    f"({align:.3f})")
