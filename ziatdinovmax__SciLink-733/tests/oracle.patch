+    row = {"analysis_id": "r1", "status": "success", "verified": True, "reason": "replay gate passed",
+           "decided_by": "replay_gate", "interpretation_checked": False, "ungated_outputs": ["n_fitted_pixels"]}
+    verified, why = board_mod._claim_verified(row)
