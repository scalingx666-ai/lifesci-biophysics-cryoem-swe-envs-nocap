+    rdmol0_smiles = Chem.MolToSmiles(rdmol0)
+    rdmol1_smiles = Chem.MolToSmiles(Chem.RemoveHs(rdmol1))
+
+    # Make sure the SMILES strings are the same.
+    assert rdmol0_smiles == rdmol1_smiles
