+def test_smiles_stereo():
+    """
+    Test that SMILES string stereochemistry is correctly preserved when
+    parameterising a molecule.
+    """
+
+    from rdkit import Chem
+
+    # Define the SMILES string.
+    smiles = "CC[C@@H](O)C"
+
