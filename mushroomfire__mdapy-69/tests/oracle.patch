 }
 
+using Doubles = nb::ndarray<const double, nb::c_contig, nb::device::cpu>;
+
+// The complex numbers of an array of float64 pairs, real and imaginary.
+const std::complex<double>* complex_data(const Doubles& values) {
+    return reinterpret_cast<const std::complex<double>*>(values.data());
+}
+
+// The rates of three-phonon scattering of the modes of one wave vector with
+// those of count wave vectors q' and their q''; complex arrays come as
+// float64 pairs, last. joined and parted are None with sigma > 0.
+nb::object three_phonon_rates(Doubles first, Doubles second, Doubles third, Doubles constants,
+                              Doubles frequencies0, Doubles frequencies1, Doubles frequencies2,
+                              Doubles occupation1, Doubles occupation2,
+                              std::optional<Doubles> joined, std::optional<Doubles> parted,
+                              double sigma, double live, nb::handle progress,
+                              const CancelToken* cancel) {
+    analysis::ScatteringInput input{};
+    input.modes = static_cast<std::int64_t>(frequencies0.shape(0));
+    input.count = static_cast<std::int64_t>(frequencies1.shape(0));
+    input.temperatures = static_cast<std::int64_t>(occupation1.shape(0));
+    const auto b = static_cast<std::size_t>(input.modes);
+    const auto count = static_cast<std::size_t>(input.count);
+    const auto temperatures = static_cast<std::size_t>(input.temperatures);
+    if (first.size() != 2 * b * b || second.size() != 2 * count * b * b ||
+        third.size() != 2 * count * b * b || constants.size() != 2 * count * b * b * b ||
+        frequencies1.size() != count * b || frequencies2.size() != count * b ||
+        occupation1.size() != temperatures * count * b ||
+        occupation2.size() != temperatures * count * b) {
+        throw std::invalid_argument("three_phonon_rates: arrays of inconsistent sizes");
+    }
+    if (sigma <= 0.0) {
+        if (!joined || !parted || joined->size() != count * b * b * b ||
+            parted->size() != count * b * b * b) {
+            throw std::invalid_argument("three_phonon_rates: weights of the deltas needed");
+        }
+        input.joined = joined->data();
+        input.parted = parted->data();
+    }
+    input.first = complex_data(first);
+    input.second = complex_data(second);
+    input.third = complex_data(third);
+    input.constants = complex_data(constants);
+    input.frequencies0 = frequencies0.data();
+    input.frequencies1 = frequencies1.data();
+    input.frequencies2 = frequencies2.data();
+    input.occupation1 = occupation1.data();
+    input.occupation2 = occupation2.data();
+    input.sigma = sigma;
+    input.live = live;
+    std::vector<double> rates(temperatures * b, 0.0);
+    run_released(
+        [&](const Control& control) { analysis::three_phonon_rates(input, rates.data(), control); },
+        progress, cancel);
+    return as_array(std::move(rates));
+}
