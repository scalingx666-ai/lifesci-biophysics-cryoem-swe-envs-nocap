+        grad_fd = central_fdm(6, 1)(params_dic[key]) do val
+            pe_injected(merge(params_dic, Dict(key => val)), sys, plan, copy(sys.coords),
+                        neighbors, gis)
+        end
+        @test abs(grads_enzyme[key] - grad_fd) <= 1e-6 * abs(grad_fd)
+    end
