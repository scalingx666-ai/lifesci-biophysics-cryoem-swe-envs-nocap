+    pt.io._format_convert('test.cpp4', 'test.dx')
+    """
+    from pytraj.core.c_core import CpptrajState, Command
+
+    state = CpptrajState()
+
+    with Command() as command:
+        command.dispatch(state, 'readdata {} name mydata'.format(input_filename))
