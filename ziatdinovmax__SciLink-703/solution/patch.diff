-    if explicit and os.path.isfile(explicit):
-        return explicit
-    # 2. FEFF_DIR env var
-    feff_dir = os.environ.get("FEFF_DIR", "").strip()
-    if feff_dir:
-        for name in _FEFF_NAMES:
-            candidate = os.path.join(feff_dir, name)
-            if os.path.isfile(candidate):
