+    three_letter_code::String
+    one_letter_code::String
+    type::String
+    polar::Bool
+    hydrophobic::Bool
+    mono_isotopic_mass::Float64
+    mass::Float64
+    charge::Int
+    custom::Bool = true
+end
+#! format: off
