+            :ndarray              : a (10,)-ndarray with the polynomial coefficients    
+        """
+        D = np.vstack([x**2+y**2-2*z**2, x**2 - 2*y**2 + z**2,
+                      4*x*y, 2*x*z, 2*y*z, x, y, z, np.ones(len(x))]).T
+        E = np.vstack([x**2+y**2+z**2]).T
+        DTD, DTE = D.T@D, D.T@E
