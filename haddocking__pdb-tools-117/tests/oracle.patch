+    ra1 = resname
+    ru0 = prev_resnum
+    ru1 = resnum
+    rl = altloc_lines
+    rv = list(rploc.values())
+
+    is_another = (
+        all((a0, ra0, ru0)) and (
+               (a0 != a1 and a1 == ' ' and ru1 > ru0)
+            or (a0 == ' ' and a1 == ' ' and (ru1 != ru0 or ra1 != ra0))
