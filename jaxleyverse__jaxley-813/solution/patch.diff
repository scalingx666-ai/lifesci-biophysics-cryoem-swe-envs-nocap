diff --git a/CHANGELOG.md b/CHANGELOG.md
index 9713d843..05a553a9 100644
--- a/CHANGELOG.md
+++ b/CHANGELOG.md
@@ -1,5 +1,10 @@
 # 0.15.0
 
+### 🐛 Bug fixes
+
+- Filter synaptic recordings by the requested state or current's synapse type,
+  while preserving the selected view, to avoid unrelated or out-of-bounds indices (#793, @Jlei61).
+
 ### 🛠️ Internal updates
 
 - Improve compilation speed for models with large amounts of recordings (#808, @alexpejovic)
diff --git a/jaxley/modules/base.py b/jaxley/modules/base.py
index 050b9283..acede7e9 100644
--- a/jaxley/modules/base.py
+++ b/jaxley/modules/base.py
@@ -2415,9 +2415,17 @@ def record(self, state: str = "v", verbose=True):
         if state in comp_states:
             in_view = self._nodes_in_view
         elif state in edge_states:
-            in_view = self.base.edges.iloc[
-                self._edges_in_view.tolist()
-            ].index_within_type.to_numpy(dtype=int)
+            # State arrays use indices within their synapse type. Restrict the
+            # viewed edges to the owner of the requested state or current first.
+            type_inds = [
+                i
+                for i, synapse in enumerate(self.base.synapses)
+                if state in synapse.synapse_states or state == f"i_{synapse._name}"
+            ]
+            edges = self.base.edges.iloc[self._edges_in_view]
+            in_view = edges.loc[
+                edges.type_ind.isin(type_inds), "index_within_type"
+            ].to_numpy(dtype=int)
         else:
             raise KeyError(f"{state} is not a recognized state in this module.")
 
