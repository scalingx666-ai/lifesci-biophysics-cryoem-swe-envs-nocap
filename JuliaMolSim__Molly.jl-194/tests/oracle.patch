+function boxes_dist(x1_min::D, x1_max::D, x2_min::D, x2_max::D, Lx::D) where D
+
+    a = abs(vector_1D(x2_max, x1_min, Lx))
+    b = abs(vector_1D(x1_max, x2_min, Lx))
+
+    return ifelse(
+        x1_min - x2_max <= zero(D) && x2_min - x1_max <= zero(D),
+        zero(D),
+        ifelse(a < b, a, b)	
+    )
+end
