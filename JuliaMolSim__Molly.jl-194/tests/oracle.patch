+function generalized_Morton_code(indices, bits::Int, D::Int)
+    code = 0
+    for bit in 0:(bits-1)
+        for d in 1:D
+            code |= ((indices[d] >> bit) & 1) << (D * bit + (d - 1))
+        end
+    end
+    return Int32(code)
+end
 
