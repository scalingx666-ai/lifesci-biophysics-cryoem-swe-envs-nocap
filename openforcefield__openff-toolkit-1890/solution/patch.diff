+                               unit="nanometer**-1",
+                               )
+
+        c = ParameterAttribute(
+            default=None,
+            unit=unit.kilojoule_per_mole * unit.nanometer ** 6,
+        )
+
+    _TAGNAME = "FOOBuckingham"
+    _INFOTYPE = FOOBuckinghamType
