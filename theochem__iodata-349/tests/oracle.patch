+    lineno
+        The line number associated with the error or warning.
+
+    Returns
+    -------
+    full_message
+        The error message formated with filename and line number info.
+    """
+    if filename is None:
+        return message
+    if lineno is None:
+        return f"{message} ({filename})"
+    return f"{message} ({filename}:{lineno})"
 
