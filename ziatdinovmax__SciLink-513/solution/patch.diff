+"""Offline tests for the #462 Phase 1 access tools on all four orchestrators.
+
+  python -m pytest tests/test_history_search_tools.py -v
+"""
+import json
+import os
+
+os.environ.setdefault("ANTHROPIC_API_KEY", "sk-dummy")
+
