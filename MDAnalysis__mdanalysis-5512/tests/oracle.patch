axis=0)\n            lmin = all_coords.min(axis=0)\n            pseud""obox[:3] = 1.1*(lmax - lmin)\n            pseudobox[3:] = 90.\n            shift = all_coords.copy()\n            shift -= lmin\n            gridsearch = FastNS(max_cutoff, shift, box=pseudobox, pbc=False)\n\n        ");
