+def test_gh_5361():
+    # GROMACS linear angle potential handling with CO2 example
+    u = mda.Universe(TPR_linear_angle)
+    actual = u.angles.to_indices()
+    expected = [[1, 0, 2]]
+    assert_equal(u.atoms.names, ["C", "O1", "O2"])
+    assert_equal(actual, expected)
