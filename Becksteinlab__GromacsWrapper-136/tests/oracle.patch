diff --git a/.travis.yml b/.travis.yml
index aa9f4176..52395470 100644
--- a/.travis.yml
+++ b/.travis.yml
@@ -1,10 +1,7 @@
-language: python
+language: generic
+group: travis_latest
 sudo: false
 
-python:
-  - "2.7"
-  - "3.6"
-
 # whitelist
 branches:
     only:
@@ -12,52 +9,57 @@ branches:
         - develop
 
 env:
-    - GMX_VERSION=4.6.5
-    - GMX_VERSION=2018
+  global:
+    - PYTHON_VERSION=2.7
+    - CODECOV=true
+    - PYTEST_FLAGS="-v --disable-pytest-warnings --durations=20"
+    - PYTEST_LIST="gromacs/tests"
+    - MAIN_CMD="pytest ${PYTEST_LIST}"
+    - SETUP_CMD="${PYTEST_FLAGS}"
+    - BUILD_CMD="pip install -v ."
+    - CONDA_DEPENDENCIES="six scipy pandas gromacs"
+    # Gromacs 2018 packages from bioconda require conda-forge for
+    # dependency, see https://bioconda.github.io/#set-up-channels
+    - CONDA_CHANNELS="defaults conda-forge bioconda"
+    - CONDA_CHANNEL_PRIORITY=True
+    - PIP_DEPENDENCIES="numkit codecov"
+    - NUMPY_VERSION=stable
+
+  matrix:
+    # use ci-helper's PACKAGENAME_VERSION magic to pin the 'gromacs' package
+    - GROMACS_VERSION=4.6.5   PYTHON_VERSION=2.7 SETUP_CMD="${PYTEST_FLAGS} --cov=gromacs"
+    - GROMACS_VERSION=2018.2  PYTHON_VERSION=2.7 SETUP_CMD="${PYTEST_FLAGS} --cov=gromacs"
+    - GROMACS_VERSION=4.6.5   PYTHON_VERSION=3.6 SETUP_CMD="${PYTEST_FLAGS} --cov=gromacs"
+    - GROMACS_VERSION=2018.2  PYTHON_VERSION=3.6 SETUP_CMD="${PYTEST_FLAGS} --cov=gromacs"
+
 
 matrix:
   fast_finish: true
   allow_failures:
-    - env: GMX_VERSION=2018
+    - env: GROMACS_VERSION=2018.2 PYTHON_VERSION=2.7
+    - env: GROMACS_VERSION=2018.2 PYTHON_VERSION=3.6
 
-# install python dependencies
+  include:
+    # note: no OSX Gromacs 2018 packages on bioconda https://anaconda.org/bioconda/gromacs/files
+    - os: osx
+      env: GROMACS_VERSION=4.6.5 PYTHON_VERSION=2.7
+    - os: osx
+      env: GROMACS_VERSION=4.6.5 PYTHON_VERSION=3.6
+    
 install:
-  # We do this conditionally because it saves us some downloading if the
-  # version is the same.
-  - if [[ "$TRAVIS_PYTHON_VERSION" == "2.7" ]]; then
-      wget https://repo.continuum.io/miniconda/Miniconda2-latest-Linux-x86_64.sh -O miniconda.sh;
-    else
-      wget https://repo.continuum.io/miniconda/Miniconda3-latest-Linux-x86_64.sh -O miniconda.sh;
-    fi
-  - bash miniconda.sh -b -p $HOME/miniconda
-  - export PATH="$HOME/miniconda/bin:$PATH"
-  - hash -r
-  - conda config --set always_yes yes --set changeps1 no
-  - conda update -q conda
-  # Useful for debugging any issues with conda
-  - conda info -a
-
-  # scipy is not a direct dependency but indirectly through numkit
-  # (but we do not have a numkit conda package yet so we pull scipy here)
-  - conda create --yes -q -n gw python=$TRAVIS_PYTHON_VERSION numpy scipy pandas
-  - source activate gw
-
-  # install becksteinlab Gromacs build
-  - conda config --add channels conda-forge
-  - conda install -c bioconda gromacs=$GMX_VERSION
-
-  # install other dependencies through pip
-  - pip install numkit
-
-  # install test tools
-  - pip install codecov
-  - pip install pytest-cov
-  - pip install pytest-pep8
-  - pip install -e .
-
-# run tests
+  - git clone --depth 1 git://github.com/astropy/ci-helpers.git
+  - source ci-helpers/travis/setup_conda.sh
+  - eval $BUILD_CMD
+
+
 script:
-  - py.test --cov gromacs gromacs/tests
+  - cd ${TRAVIS_BUILD_DIR}
+  - if [[ $TRAVIS_OS_NAME == 'osx' ]]; then ulimit -S -n 2048; fi
+  - echo $MAIN_CMD $SETUP_CMD
+  - eval $MAIN_CMD $SETUP_CMD
 
 after_success:
-  - codecov
+  - |
+    if [[ $CODECOV == 'true' ]]; then \
+      codecov; \
+    fi
