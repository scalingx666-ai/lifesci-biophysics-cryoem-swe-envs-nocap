+### Some atoms only
+
+To analyze some atoms only, as a sublattice of an alloy, analyze the system
+of those atoms; the others are as if they were not there. The gallium of
+gallium arsenide, a zinc blende of two fcc lattices, is fcc:
+
+```python
+from mdapy.build import dislocation_quadrupole
+
+gaas = dislocation_quadrupole(
+    "diamond screw", 5.65, (119.0, 53.8, 59.5), (6, 10, 3), elements=("Ga", "As")
+)
+gallium = gaas["element"] == "Ga"
+found = DislocationAnalysis("fcc").compute(gaas.filter(gallium))
+[line.family for line in found.lines]  # ["1/2<110>", "1/2<110>"]
+structure = np.zeros(len(gaas), dtype=np.int8)  # of every atom, other for As
+structure[gallium] = found.structure
+```
+
+The per-atom results are those of the atoms analyzed, in their order.
+
 ### CA files
 
 `result.write("dislocations.ca")` writes the result as a crystal analysis
diff --git a/src/mdapy/analysis/_dislocations.py b/src/mdapy/analysis/_dislocations.py
index b60411fc..c4384884 100644
--- a/src/mdapy/analysis/_dislocations.py
+++ b/src/mdapy/analysis/_dislocations.py
@@ -227,6 +227,17 @@ def total_length(self) -> float:
         """Total length of the lines in Å."""
         return float(sum(line.length for line in self.lines))
 
+    @property
+    def density(self) -> float:
+        """Total length of the lines per volume of the box, in Å⁻²."""
+        return self.total_length / self.defect_mesh.box.volume
+
+    def densities(self) -> dict[str, float]:
+        """Length per volume of the box in Å⁻² of the lines of each family
+        of Burgers vectors of the crystal, "other" last."""
+        volume = self.defect_mesh.box.volume
+        return {name: length / volume for name, length in self.lengths().items()}
+
     def counts(self) -> dict[str, int]:
         """Number of atoms of each structure, by name."""
         found = np.bincount(self.structure, minlength=len(self.names))
