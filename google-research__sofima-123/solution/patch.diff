+    map1_3d = rng.uniform(-15.0, 60.0, size=(3, 6, 8, 9)).astype(np.float32)
+    gz3, gy3, gx3 = np.mgrid[:8, :10, :12]
+    map2_3d = np.stack(
+        [
+            0.3 * gx3 - 0.2 * gy3 + 0.1 * gz3,
+            -0.1 * gx3 + 0.25 * gy3 - 0.15 * gz3,
