+    m2 = np.full((2, 1, 12, 14), np.nan, dtype=np.float64)
+    valid_2d = ((hy - 6) ** 2 + (hx - 7) ** 2 <= 16) & ~((hy >= 6) & (hx >= 7))
+    m2[0, 0, valid_2d] = hx[valid_2d] * 2.0 + hy[valid_2d] * 0.5
