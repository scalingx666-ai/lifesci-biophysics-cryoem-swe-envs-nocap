           if [[ ${{ matrix.os }} == ubuntu-* ]]; then SHLIB=so; else SHLIB=dylib; fi
           # This is always built
@@ -405,9 +405,9 @@ jobs:
         run: |
           call "C:\Program Files\Microsoft Visual Studio\18\Enterprise\VC\Auxiliary\Build\vcvarsall.bat" x64
           cd build
-          jom -j 2
+          jom -j 4
           if errorlevel 1 exit 1
-          jom -j 2 install
