+#ifndef NNPOPS_CFCONVNEIGHBORS
+#define NNPOPS_CFCONVNEIGHBORS
+
+#include <torch/script.h>
+#include "CFConv.h"
+
+namespace NNPOps {
+namespace CFConvNeighbors {
+
+class Holder : public torch::CustomClassHolder {
