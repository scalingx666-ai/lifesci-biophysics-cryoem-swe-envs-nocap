+    atoms = np.vstack([[[c, 5, 5], [c + 0.6, 5, 5], [c - 0.6, 5, 5]] for c in centers])
+    numbers = np.repeat(np.arange(1, len(centers) + 1), 3)
+    system = mdapy.System(
+        atoms, mdapy.Box(40.0), elements=["O", "H", "H"] * len(centers)
+    )
+    return system.with_columns(molecule=numbers)
