+++ b/python/plumed/_hdf5.py
@@ -0,0 +1,546 @@
+# /* +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
+#   Copyright (c) 2026 The plumed team
+#   (see the PEOPLE file at the root of the distribution for a list of names)
+#
+#   See http://www.plumed.org for more information.
