+        roundtripped = _SimpleMolecule.from_dict(simple_dipeptide.to_dict())
+
+        assert [residue.residue_name for residue in roundtripped.residues] == [
+            "ACE",
+            "ALA",
+        ]
+
+        assert [residue.residue_number for residue in roundtripped.residues] == [
+            "1",
+            "2",
+        ]
+
