+def _state(**extra):
+    st = {"skills_loaded": [dict(_SKILL)],
+          "skill_sections": dict(_SKILL), "skill_name": "xps"}
+    st.update(extra)
+    return st
+
+
+def _render(mod, state, stage):
+    parts = []
+    mod._append_skill_context(parts, state, stage)
+    return parts
