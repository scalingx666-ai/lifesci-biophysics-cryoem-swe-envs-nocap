+_SKILL = {
+    "name": "xps",
+    "planning": "PLAN-RULES",
+    "analysis": "ANALYSIS-RULES",
+    "implementation": "IMPL-RULES",
+    "interpretation": "INTERP-RULES",
+    "validation": "VALID-RULES",
+}
