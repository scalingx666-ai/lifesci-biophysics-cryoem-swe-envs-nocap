+void NEP_VDW::compute_forces(
+  const ANN& ann, Dataset& data, const NEP_Neighbor& neighbors,
+  NEP_VDW_Data& storage)
+{
+  const int block_size = 32;
+  const int grid_size = (data.N - 1) / block_size + 1;
