+      storage.parameters.data(),
+      storage.Fp.data(),
+      storage.C6_derivative.data(),
+      storage.D_C6.data(),
+      data.force.data(),
+      data.force.data() + data.N,
+      data.force.data() + data.N * 2,
+      data.virial.data());
+  } else {
+    find_force_radial<<<grid_size, block_size>>>(
+      data.N,
+      data.NN_radial_sum.data(),
+      data.NN_radial.data(),
+      neighbors.NL_radial.data(),
