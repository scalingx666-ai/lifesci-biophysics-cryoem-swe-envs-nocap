diff --git a/package/CHANGELOG b/package/CHANGELOG
index 426918e0e1..bb39d6d262 100644
--- a/package/CHANGELOG
+++ b/package/CHANGELOG
@@ -23,6 +23,9 @@ The rules for this file:
  * 2.11.0
 
 Fixes
+ * `GNMAnalysis` silently and wrongly reduced the split `eigenvectors` array
+   via hstack instead of vstack when using multiprocessing, and would raise
+   an error with uneven split of frames across workers (Issue #5494, PR #5495)
  * `AnalysisBase.run()` now interprets NumPy boolean arrays passed to `frames`
    as frame masks instead of integer frame indices (Issue #5472)
  * Mass (u) has been added to MDAnalysis base units and clarified that physical
diff --git a/package/MDAnalysis/analysis/gnm.py b/package/MDAnalysis/analysis/gnm.py
index a767c5c578..2cc0547e70 100644
--- a/package/MDAnalysis/analysis/gnm.py
+++ b/package/MDAnalysis/analysis/gnm.py
@@ -255,6 +255,12 @@ class GNMAnalysis(AnalysisBase):
        Enabled **parallel execution** with the ``multiprocessing`` and ``dask``
        backends; use the new method :meth:`get_supported_backends` to see all
        supported backends.
+
+    .. versionchanged:: 2.11.0
+       Fixed incorrect stacking of results from multiprocessing. Previously
+       ``results.eigenvectors`` would silently return an array of the wrong
+       shape. It now correctly use ``np.vstack`` for reducing the eigenvectors
+       from multiple workers.
     """
 
     _analysis_algorithm_is_parallelizable = True
@@ -377,7 +383,7 @@ def _conclude(self):
     def _get_aggregator(self):
         return ResultsGroup(
             lookup={
-                "eigenvectors": ResultsGroup.ndarray_hstack,
+                "eigenvectors": ResultsGroup.ndarray_vstack,
                 "eigenvalues": ResultsGroup.ndarray_hstack,
                 "times": ResultsGroup.ndarray_hstack,
             }
diff --git a/testsuite/MDAnalysisTests/analysis/test_gnm.py b/testsuite/MDAnalysisTests/analysis/test_gnm.py
index dcc625e5b4..beaccacee0 100644
--- a/testsuite/MDAnalysisTests/analysis/test_gnm.py
+++ b/testsuite/MDAnalysisTests/analysis/test_gnm.py
@@ -233,3 +233,11 @@ def test_closeContactGNMAnalysis_select_CA(universe, client_GNMAnalysis):
         ], atol=1e-3, rtol=0
     )
     # fmt: on
+
+
+def test_gnm_odd_frames_per_worker(universe):
+    # explicit test for #5494 wrong shape being returned and a
+    # crash if uneven frames split between workers
+    gnm = mda.analysis.gnm.GNMAnalysis(universe)
+    results = gnm.run(stop=9, backend="multiprocessing", n_workers=2).results
+    assert results.eigenvectors.shape == (9, 214)
