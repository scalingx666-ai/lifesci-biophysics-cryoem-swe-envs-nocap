+"""
+    scale_vec(v, c)
+
+Broadcasted form of `.* c`, allowing scaling all the vectors in v by c, where c is
+either a constant or a vector.
+"""
+scale(v, c) = v .* c
+scale_vec(v, c) = scale.(v, Ref(c))
