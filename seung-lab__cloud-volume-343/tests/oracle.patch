@@ -100,6 +100,11 @@ def promote_to_head(self, node):
   def delete(self, node):
     nxt, prev = node.next, node.prev
 
+    if self.head == node:
+      self.head = nxt
+    if self.tail == node:
+      self.tail = prev
+
     if prev is not None:
       prev.next = nxt
 
@@ -133,11 +138,12 @@ def prepend(self, val):
       self.head = ListNode(val, None, None)
       self.tail = self.head
     elif self.head is None:
