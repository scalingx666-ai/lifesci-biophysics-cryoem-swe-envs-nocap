+    # density (mesh points per unit length) stays roughly constant across
+    # particle numbers and volume fractions.
+    ref_box_l = (1000 * 4. / 3. * np.pi * (lj_sig / 2.)**3 / 0.25)**(1. / 3.)
+    mesh_min = max(4, int(np.round(16 * (box_l / ref_box_l)**.5)))
