     # Write MOs (mo #, occ #, energy)
-    mo_iter = enumerate(zip(data.mo.occs, data.mo.energies, mo_coeffs.transpose(), strict=True))
+    # The WFN format always has an orbital energy, so zeros are written when they are not known.
