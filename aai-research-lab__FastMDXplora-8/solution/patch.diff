+    forwarder_relaxed = OptionsForwarder(pre_hooks={"flag": failing_hook}, strict=False)
+    forwarded_relaxed, _ = forwarder_relaxed.process_options({"flag": True})
+    assert forwarded_relaxed["flag"] is True
