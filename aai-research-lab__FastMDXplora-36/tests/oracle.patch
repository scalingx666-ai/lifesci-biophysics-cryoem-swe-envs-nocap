+    ("Darwin", "arm64"): "Miniforge3-MacOSX-arm64.sh",
+    ("Windows", "x86_64"): "Miniforge3-Windows-x86_64.exe",
+    ("Windows", "aarch64"): None,  # upstream does not publish this asset
+}
