+def test_dump_xyz_position_mode_preserves_velocity_reinitialization(tmp_path, gpumd_command):
+    """Changing the output coordinates must not change a later seeded velocity command."""
+    atoms = Atoms('C4', cell=[40, 40, 40], pbc=True,
+                  positions=[[2, 2, 2], [20, 2, 2], [2, 20, 2], [2, 2, 20]])
+    velocities = {}
+    for mode, options in POSITION_OPTIONS.items():
+        directory = tmp_path / mode
+        case = CommandIOCase(
+            name='dump_xyz_velocity_reinitialization', skip_base_block=True,
+            run_in_lines=[
+                ('velocity', [300, 'seed', 42]),
+                ('time_step', 1),
+                ('ensemble', 'nve'),
+                ('dump_xyz', [10, 'trajectory.xyz', *options]),
+                ('run', 20),
+                ('velocity', [300, 'seed', 123]),
+                ('time_step', 0),
+                ('ensemble', 'nve'),
+                ('dump_xyz', [1, 'reinitialized.xyz', 'velocity', 'precision', 'double']),
+                ('run', 1),
+            ])
+        result = run_command_io_case(
+            directory, atoms, MODELS_DIR / 'nep_C.txt', 'nep', gpumd_command, case)
+        assert result.returncode == 0, f'{result.stdout}\n{result.stderr}'
+        velocities[mode] = read(directory / 'reinitialized.xyz').arrays['vel']
+    np.testing.assert_array_equal(velocities['unwrapped'], velocities['wrapped'])
+    np.testing.assert_array_equal(velocities['both'], velocities['wrapped'])
