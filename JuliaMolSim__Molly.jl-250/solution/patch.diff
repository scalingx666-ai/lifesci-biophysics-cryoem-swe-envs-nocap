+        end
+        for i in 1:K
+            ws.rhs[i] = data.sdiag[i] * (dot(ws.B[i], xp[data.atom1[i]] - xp[data.atom2[i]]) - data.lengths[i])
+        end
+        ws.sol .= ws.rhs
+
+        # Warmup
+        Molly.lincs_solve!(xp, data, ws, 1.0)
+        ws.sol .= ws.rhs
+        xp .= x .+ v .* 0.002
+
+        allocs = @allocated Molly.lincs_solve!(xp, data, ws, 1.0)
+        @test allocs == 0
+    end
+end
