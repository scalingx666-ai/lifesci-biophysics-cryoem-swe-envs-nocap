+        force_constant = 2 ** (4 * lam)
+        return (offset, force_constant)
+
+    initial_lams = np.linspace(0, 1, initial_num_states)
+    initial_params = [initial_path(lam) for lam in initial_lams]
+
+    with patch("numpy.int", int):
