diff --git a/regtest/scripts/run b/regtest/scripts/run
index a3d7557967..3359c8725a 100755
--- a/regtest/scripts/run
+++ b/regtest/scripts/run
@@ -43,6 +43,7 @@ mpiprocs=0
 
 plumed_needs=
