+  elif grep -q '^DEFERRED (long test' $file ; then
+    ((deferred++))
   elif grep -q FAILURE $file ; then
     ((nerror++))
     echo + ERROR in test $dir >> $file2
@@ -58,6 +61,9 @@ cat $file2
 echo "+++++++++++++++++++++++++++++++++++++++++++++++++++++"
 echo "+ Final report:"
