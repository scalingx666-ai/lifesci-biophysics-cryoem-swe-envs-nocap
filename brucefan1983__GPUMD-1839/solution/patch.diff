+void TNEP::compute_descriptors(
+  const ANN& ann,
+  const Dataset& dataset,
+  const NEP_Neighbor& neighbor,
+  TNEP_Data& data)
+{
+  const int block_size = 32;
+  const int grid_size = (dataset.N - 1) / block_size + 1;
+
+  if (compiled_kernel_) {
+    compiled_kernel_->launch_descriptor_radial(
+      dataset.N,
+      dataset.NN_radial_sum.data(),
+      dataset.NN_radial.data(),
+      neighbor.NL_radial.data(),
+      dataset.type.data(),
+      neighbor.x12_radial.data(),
+      neighbor.y12_radial.data(),
+      neighbor.z12_radial.data(),
+      data.parameters.data(),
+      data.descriptors.data());
+  } else {
+    find_descriptors_radial<<<grid_size, block_size>>>(
+      dataset.N,
+      dataset.NN_radial_sum.data(),
+      dataset.NN_radial.data(),
+      neighbor.NL_radial.data(),
+      paramb,
+      ann,
+      dataset.type.data(),
+      neighbor.x12_radial.data(),
+      neighbor.y12_radial.data(),
+      neighbor.z12_radial.data(),
+      data.descriptors.data());
+    GPU_CHECK_KERNEL
+  }
+
+  if (compiled_kernel_) {
+    compiled_kernel_->launch_descriptor_angular(
+      dataset.N,
+      dataset.NN_angular_sum.data(),
+      dataset.NN_angular.data(),
+      neighbor.NL_angular.data(),
+      dataset.type.data(),
+      neighbor.x12_angular.data(),
+      neighbor.y12_angular.data(),
+      neighbor.z12_angular.data(),
+      data.parameters.data(),
+      data.descriptors.data(),
+      data.sum_fxyz.data());
+  } else {
+    find_descriptors_angular<<<grid_size, block_size>>>(
+      dataset.N,
+      dataset.NN_angular_sum.data(),
+      dataset.NN_angular.data(),
+      neighbor.NL_angular.data(),
+      paramb,
+      ann,
+      dataset.type.data(),
+      neighbor.x12_angular.data(),
+      neighbor.y12_angular.data(),
+      neighbor.z12_angular.data(),
+      data.descriptors.data(),
+      data.sum_fxyz.data());
+    GPU_CHECK_KERNEL
+  }
+}
+
+void TNEP::evaluate_ann(
+  const ANN& ann,
+  bool is_polarizability,
+  Dataset& dataset,
+  TNEP_Data& data,
+  const float* q_scaler)
+{
+  const int block_size = 32;
+  const int grid_size = (dataset.N - 1) / block_size + 1;
+
+  if (compiled_kernel_) {
+    if (is_polarizability) {
+      compiled_kernel_->launch_ann_tnep_pol(
+        dataset.N,
+        dataset.type.data(),
+        data.descriptors.data(),
+        q_scaler,
+        data.parameters.data(),
+        dataset.virial.data(),
+        data.Fp.data());
+    } else {
+      compiled_kernel_->launch_ann(
+        dataset.N,
+        dataset.type.data(),
+        data.descriptors.data(),
+        q_scaler,
+        data.parameters.data(),
+        dataset.energy.data(),
+        data.Fp.data());
+    }
+  } else {
+    if (is_polarizability) {
+      apply_ann_pol<<<grid_size, block_size>>>(
+        dataset.N,
+        paramb,
+        ann,
+        dataset.type.data(),
+        data.descriptors.data(),
+        q_scaler,
+        dataset.virial.data(),
+        data.Fp.data());
+      GPU_CHECK_KERNEL
+    } else {
+      apply_ann<<<grid_size, block_size>>>(
+        dataset.N,
+        paramb,
+        ann,
+        dataset.type.data(),
+        data.descriptors.data(),
+        q_scaler,
+        dataset.energy.data(),
+        data.Fp.data());
+      GPU_CHECK_KERNEL
+    }
+  }
+}
