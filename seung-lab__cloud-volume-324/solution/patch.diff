+  delete_layer()
+  cv, _ = create_layer(size=(1024, 1024, 2, 1), offset=(0,0,0))
+
+  cv.meta.lock_mips(0)
+  cv.meta.lock_mips([0])
+
+  try:
+    cv[:,:,:] = 0
+    assert False 
+  except ReadOnlyException:
+    pass 
+
+  cv.meta.unlock_mips(0)
+  cv.meta.unlock_mips([0])
+
