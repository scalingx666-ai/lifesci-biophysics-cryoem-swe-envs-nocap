diff --git a/jaxley/optimize/transforms.py b/jaxley/optimize/transforms.py
index fabd91da..8b7dce90 100644
--- a/jaxley/optimize/transforms.py
+++ b/jaxley/optimize/transforms.py
@@ -20,10 +20,24 @@ def forward(self, x: ArrayLike) -> Array:
         pass
 
     @abstractmethod
-    def inverse(self, x: ArrayLike) -> Array:
+    def inverse(self, y: ArrayLike) -> Array:
         pass
 
 
+class IdentityTransform(Transform):
+    """Identity transformation."""
+
+    def __init__(self) -> None:
+        """This transform does nothing to its input."""
+        super().__init__()
+
+    def forward(self, x: ArrayLike) -> Array:
+        return x
+
+    def inverse(self, y: ArrayLike) -> Array:
+        return y
+
+
 class SigmoidTransform(Transform):
     """Sigmoid transformation."""
 
