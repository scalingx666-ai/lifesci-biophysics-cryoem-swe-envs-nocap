+# 2. Transform one of the disks into a rod.
+#    (Note: Wildcards, "mols[*][*][*]", do not work with "set" commands.)
+write_once("In Set Atom") {
+  set atom mols[2][2][2]/ben type @atom:ROD/b1
+  set atom mols[2][2][2]/ben shape 2.5 2.5 6.5
+}
+\end{verbatim}
 
