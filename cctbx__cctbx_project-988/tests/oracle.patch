+    if len(atom_id) == 16:
+      return atom_id[6:7]
+
+  @staticmethod
+  def get_resname_probe_atom_id(atom_id):
+    if len(atom_id) == 16:
+      return atom_id[7:10]
+
+  @staticmethod
+  def get_atom_probe_atom_id(atom_id):
+    if len(atom_id) == 16:
+      return atom_id[11:15]
