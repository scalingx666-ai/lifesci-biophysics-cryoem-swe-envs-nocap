+            shutil.copyfile(sidecar, dest.with_suffix(".json"))
+        print(f"    🚫 Skipping {len(rows)} unverified row(s): "
+              + ", ".join(f"{r['unit']} ({r['reason']})" for r in rows[:8]))
+        return str(dest), rows, []
+
