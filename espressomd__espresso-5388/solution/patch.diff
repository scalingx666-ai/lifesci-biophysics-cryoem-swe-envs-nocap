index 0000000000..bc370c42a9
--- /dev/null
+++ b/testsuite/python/rigid_bond_virial.py
@@ -0,0 +1,195 @@
+#
+# Copyright (C) 2026 The ESPResSo project
+#
+# This file is part of ESPResSo.
+#
