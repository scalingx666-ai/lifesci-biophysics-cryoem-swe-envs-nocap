+    result += project_force_to_C_from_dxdqi<0>(sum_dxdq[0]);
+    result += project_force_to_C_from_dxdqi<1>(sum_dxdq[1]);
+    result += project_force_to_C_from_dxdqi<2>(sum_dxdq[2]);
+    result += project_force_to_C_from_dxdqi<3>(sum_dxdq[3]);
