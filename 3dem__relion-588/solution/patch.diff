+											  RFLOAT *dfourier_mask, int fx, int fy, int fz, bool do_fourier_mask)
+{
+#ifdef CUDA
+	dim3 bs(32,4,2);
+	dim3 gs(ceil((padoridim/2+1)/(float)bs.x), ceil(padoridim/(float)bs.y), ceil(padoridim/(float)bs.z));
