+@dataclass(frozen=True)
+class MCSResult:
+    all_maps: Tuple[Tuple[int, ...], ...]
+    all_marcs: Tuple[NDArray, ...]
+    num_edges: int
+    timed_out: bool
+    nodes_visited: int
