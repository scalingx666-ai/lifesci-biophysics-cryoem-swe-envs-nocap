     >>> # Make hairpin for residue 1 to 5 and make alpha helix for residue 6 to 12
     >>> traj = pt.make_structure(traj, ["hairpin:1-5", "alpha:6-12"])
 
+    >>> # Make new structure from reference
+    >>> def make_new_by_using_ref(): # doctest: +SKIP
+    ...     tz2_parm7 = 'tz2.parm7'
