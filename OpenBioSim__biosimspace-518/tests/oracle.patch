diff --git a/src/BioSimSpace/Solvent/_ions.py b/src/BioSimSpace/Solvent/_ions.py
new file mode 100644
index 000000000..18d106e6c
--- /dev/null
+++ b/src/BioSimSpace/Solvent/_ions.py
@@ -0,0 +1,683 @@
+######################################################################
+# BioSimSpace: Making biomolecular simulation a breeze!
+#
+# Copyright: 2017-2025
+#
+# Authors: Lester Hedges <lester.hedges@gmail.com>
