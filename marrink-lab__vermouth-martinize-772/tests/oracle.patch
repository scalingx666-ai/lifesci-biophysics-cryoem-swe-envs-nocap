-    """
-    Parse a string like X[1-3,6,8] to list [X1,X2,X3,X6,X8].
-    X[20-25] is invalid, but X[w-z] is valid.
-    """
-
-    if '[' not in nodestr:
-        return [nodestr]
-
-    openbra = nodestr.find('[')
-    closebra = nodestr.rfind(']')
